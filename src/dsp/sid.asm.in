; F030SID DSP kernel (template; tools/dsp/gen_sid_asm.py expands it to SID.ASM)
;
; Milestone 3: the three voices of the reference model (src/ref/sid_ref.c), bit
; for bit against the C model: every waveform setting with noise and the
; combined waveforms, hard sync and ring modulation between the voices (each is
; synced and ring-modulated by the one before it), the test bit, the exact
; ADSR state machine, and the three 24-bit outputs
; (wave DAC - zero) * envelope DAC. Frame by frame on host request
; (DSP_CMD_FRAME replies with the three voice outputs). The filter, the mixer,
; band-limiting and the SSI stream follow in later milestones.
; See docs/dsp-kernel.md.
;
; Loaded in two stages: a 512-word bootstrap (stage2_loader.asm) installs this
; sparse program, which may extend into external P RAM, and jumps to P:$0000.
; The host then loads the tables with DSP_CMD_LOAD_X / DSP_CMD_LOAD_Y.
;
; Register conventions: a, b, x0, x1, y0, r0, r1, n0, n1 are scratch;
; y1 holds the written value across the write_reg handlers.

        include 'ioequ.inc'
        include 'protocol.inc'

ST_ATTACK       equ     0
ST_DECSUS       equ     1
ST_RELEASE      equ     2

; Fractional part of the cycles per codec frame, Q24: SID_CYC_Q24 & $ffffff
; (SID_CYC_Q24 = 336175407 = 20.0376 * 2^24, see src/ref/sid_ref.h).
EPS_INC         equ     $09a12f

; X internal globals ($00-$0f, short-addressed)
G_EPS           equ     $00             ; Q24 sample-instant fraction
G_ZERO          equ     $01             ; wave zero level (config)
G_TTLSTART      equ     $02             ; floating TTL start (config)
G_MODEL         equ     $03             ; 0 = 6581, 1 = 8580 (config)
G_SRSTART       equ     $04             ; shift register reset start (config)
G_N             equ     $05             ; cycles in this frame
G_DTOSC         equ     $06             ; cycles of the frame left to clock the oscillators
G_DTMIN         equ     $07             ; cycles of the current oscillator step

;@equates

S_SHADOW        equ     $a8             ; 32-word register shadow

        org     p:$0000
        jmp     start

        org     p:$0080                 ; P:$0040-$007f belongs to the stage-two loader
start:
        movep   #0,x:m_bcr              ; reset leaves external memory at 15 wait states
        movep   #1,x:m_pbc              ; enable the Falcon host port
        jsr     reset_state

main_loop:
        jclr    #0,x:m_hsr,main_loop    ; HRDF: a command word arrived
        movep   x:m_hrx,a
        move    #>DSP_CMD_FRAME,x0
        cmp     x0,a
        jeq     cmd_frame
        move    #>DSP_CMD_WRITE_REG,x0
        cmp     x0,a
        jeq     cmd_write
        move    #>DSP_CMD_LOAD_X,x0
        cmp     x0,a
        jeq     cmd_load
        move    #>DSP_CMD_LOAD_Y,x0
        cmp     x0,a
        jeq     cmd_load_y
        move    #>DSP_CMD_CONFIG,x0
        cmp     x0,a
        jeq     cmd_config
        move    #>DSP_CMD_PING,x0
        cmp     x0,a
        jeq     cmd_ping
        move    #>DSP_CMD_READ_REG,x0
        cmp     x0,a
        jeq     cmd_read
        move    #>DSP_CMD_RESET,x0
        cmp     x0,a
        jeq     cmd_reset
reply_error:
        move    #>DSP_REPLY_ERROR,a
        jmp     reply
cmd_ping:
        move    #>DSP_REPLY_HELLO,a
        jmp     reply
cmd_reset:
        jsr     reset_state
reply_ok:
        clr     a
reply:                                  ; a1 = reply word
        jclr    #1,x:m_hsr,*            ; HTDE: host consumed the last reply
        movep   a1,x:m_htx
        jmp     main_loop

; ---------------------------------------------------------------- host side

cmd_load:                               ; address, count, words -> X memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r0)+
load_done:
        jmp     reply_ok

cmd_load_y:                             ; address, count, words -> Y memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_y_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y:(r0)+
load_y_done:
        jmp     reply_ok

cmd_config:                             ; wave zero, floating TTL, model, shift reset start
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_ZERO
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_TTLSTART
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_MODEL
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_SRSTART
        jmp     reply_ok

cmd_read:                               ; reg -> shadow value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     reply_error
        move    x1,n0
        move    #>S_SHADOW,r0
        nop
        move    x:(r0+n0),a
        jmp     reply

cmd_write:                              ; reg, value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y1
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     reply_ok                ; not a SID register
        move    x1,n0
        move    #>S_SHADOW,r0
        nop
        move    y1,x:(r0+n0)            ; shadow for READ_REG
        move    x1,a
        move    #>21,x0
        cmp     x0,a
        jge     reply_ok                ; filter and read-only registers: later milestones
        move    #>14,x0
        cmp     x0,a
        jlt     cw_not2
        sub     x0,a                    ; voice 3 (index 2)
        move    a1,x1
        jmp     write_reg_2
cw_not2:
        move    #>7,x0
        cmp     x0,a
        jlt     write_reg_0
        sub     x0,a
        move    a1,x1
        jmp     write_reg_1

; ------------------------------------------------------------------- helpers

rate_lookup:                            ; a1 = nibble -> a = rate counter period
        move    a1,n1
        move    #>DSP_X_RATE_TAB,r1
        nop
        move    x:(r1+n1),a
        rts

reset_state:                            ; the model's power-on state
        clr     a
        move    #0,r0
        rep     #$88
        move    a,x:(r0)+               ; globals and the three voice blocks
        move    #>S_SHADOW,r0
        rep     #32
        move    a,x:(r0)+
        jsr     reset_voice_0
        jsr     reset_voice_1
        jsr     reset_voice_2
        rts

; ---------------------------------------------------------------- one frame

cmd_frame:
        clr     a                       ; n = 20 + carry of the Q24 fraction
        move    x:<G_EPS,a0
        move    #0,x1
        move    #>EPS_INC,x0
        add     x,a                     ; 48-bit add: a1 = carry, a0 = new fraction
        move    a0,x:<G_EPS
        move    a1,x0
        move    #>20,a
        add     x0,a
        move    a1,x:<G_N
        move    a1,x:<G_DTOSC
        move    a1,x:V0_TMPDT
        move    a1,x:V1_TMPDT
        move    a1,x:V2_TMPDT
        jsr     env_clock_0
        jsr     env_clock_1
        jsr     env_clock_2

fr_osc_loop:                            ; oscillators, split at every sync-source msb toggle
        move    x:<G_DTOSC,a
        move    a1,x:<G_DTMIN
        jsr     sync_check_0
        jsr     sync_check_1
        jsr     sync_check_2
        jsr     wave_clock_0
        jsr     wave_clock_1
        jsr     wave_clock_2
        jsr     synchronize_0
        jsr     synchronize_1
        jsr     synchronize_2
        move    x:<G_DTOSC,a
        move    x:<G_DTMIN,x0
        sub     x0,a
        move    a1,x:<G_DTOSC
        tst     a
        jne     fr_osc_loop
        jsr     outstage_0
        jsr     outstage_1
        jsr     outstage_2

        move    x:V0_OUT,a              ; the three voice outputs
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:V1_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:V2_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        jmp     main_loop

;@voice
; ============================================================ voice @V@
; Register writes: x1 = register within the voice (0..6), y1 = value

write_reg:
        move    x1,a
        tst     a
        jeq     wr_freq_lo
        move    #>1,x0
        cmp     x0,a
        jeq     wr_freq_hi
        move    #>2,x0
        cmp     x0,a
        jeq     wr_pw_lo
        move    #>3,x0
        cmp     x0,a
        jeq     wr_pw_hi
        move    #>4,x0
        cmp     x0,a
        jeq     wr_control
        move    #>5,x0
        cmp     x0,a
        jeq     wr_ad
        move    #>6,x0
        cmp     x0,a
        jeq     wr_sr
        jmp     reply_ok

wr_freq_lo:
        move    x:S_FREQ,a
        move    #>$ff00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        move    a1,x:S_FREQ
        jmp     reply_ok

wr_freq_hi:
        move    x:S_FREQ,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    b1,x0
        or      x0,a
        move    a1,x:S_FREQ
        jmp     reply_ok

wr_pw_lo:
        move    x:S_PW,a
        move    #>$f00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        move    a1,x:S_PW
        jsr     calc_pulse_out
        jmp     reply_ok

wr_pw_hi:
        move    x:S_PW,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    #>$f00,x0
        and     x0,b
        move    b1,x0
        or      x0,a
        move    a1,x:S_PW
        jsr     calc_pulse_out
        jmp     reply_ok

wr_ad:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_ATTACK
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,x:S_DECAY
        move    x:S_STATE,a
        tst     a
        jne     wad_notatk
        move    x:S_ATTACK,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok
wad_notatk:
        move    #>ST_DECSUS,x0
        cmp     x0,a
        jne     reply_ok
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok

wr_sr:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_SUSTAIN
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,x:S_RELEASE
        move    x:S_STATE,a
        move    #>ST_RELEASE,x0
        cmp     x0,a
        jne     reply_ok
        move    x:S_RELEASE,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok

; WaveformGenerator::writeCONTROL_REG, then EnvelopeGenerator's
wr_control:
        move    x:S_WAVEFORM,a
        move    a1,x:S_TMPA             ; waveform_prev
        move    x:S_TEST,a
        move    a1,x:S_TMPB             ; test_prev
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_WAVEFORM
        move    y1,a
        move    #>8,x0
        and     x0,a
        move    a1,x:S_TEST
        clr     a                       ; sync bit (1)
        move    a1,x:S_SYNC
        jclr    #1,y1,wc_sync_done
        move    #>2,x0
        move    x0,x:S_SYNC
wc_sync_done:
        clr     a                       ; ring: bit 2 set and the saw bit (5) clear
        move    a1,x:S_RING
        jset    #5,y1,wc_ring_done
        jclr    #2,y1,wc_ring_done
        move    #>1,x0
        move    x0,x:S_RING
wc_ring_done:
        move    x:S_TMPB,a
        tst     a
        jne     wc_test_was_on
        move    x:S_TEST,a              ; test off before
        tst     a
        jeq     wc_after_test
        clr     a                       ; test rising: phase 0, shift register reset, pulse high
        move    a1,x:S_ACC
        move    x:<G_SRSTART,x0
        move    x0,x:S_SRRESET
        move    #>$fff,x0
        move    x0,x:S_PULSE
        jmp     wc_after_test
wc_test_was_on:
        move    x:S_TEST,a
        tst     a
        jne     wc_after_test           ; test stays on
        jsr     pre_writeback_check     ; test falling: maybe write the waveform into the register
        tst     a
        jeq     wc_nowb
        jsr     write_shift_register
wc_nowb:
        move    x:S_SR,x0               ; bit0 = (~sr >> 17) & 1; one shift
        clr     b
        jset    #17,x0,wc_bit0_done
        move    #>1,b
wc_bit0_done:
        move    x0,a
        lsl     a
        move    b1,x0
        or      x0,a
        move    #>$7fffff,x0
        and     x0,a
        move    a1,x:S_SR
        jsr     set_noise_output
wc_after_test:
        move    x:S_WAVEFORM,a
        tst     a
        jeq     wc_nowave
        jsr     wave_set_output
        jmp     wc_env
wc_nowave:
        move    x:S_TMPA,a              ; waveform dropped to none: output floats
        tst     a
        jeq     wc_env
        move    x:<G_TTLSTART,x0
        move    x0,x:S_TTL
wc_env:
        move    y1,a                    ; envelope gate
        move    #>1,x0
        and     x0,a
        move    a1,x:S_TMPA             ; gate_next
        move    x:S_GATE,x0
        cmp     x0,a
        jeq     reply_ok
        tst     a
        jeq     wc_release
        move    #>ST_ATTACK,x0
        move    x0,x:S_NEXT
        move    #>ST_DECSUS,x0
        move    x0,x:S_STATE
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     wc_pipe
wc_release:
        move    #>ST_RELEASE,x0
        move    x0,x:S_NEXT
wc_pipe:
        move    #>2,x0
        move    x0,x:S_PIPE
        move    x:S_TMPA,a
        move    a1,x:S_GATE
        jmp     reply_ok

reset_voice:                            ; the voice's power-on state (its block is already zero)
        move    #>$555555,x0
        move    x0,x:S_ACC
        move    #>$fff,x0
        move    x0,x:S_PULSE
        move    #>$aa,x0
        move    x0,x:S_ENVCNT
        move    #>8,x0
        move    x0,x:S_RATEPER
        move    #>1,x0
        move    x0,x:S_EXPPER
        move    #>ST_RELEASE,x0
        move    x0,x:S_STATE
        move    x0,x:S_NEXT
        move    #>$7ffffe,x0
        move    x0,x:S_SR
        jmp     set_noise_output

; pulse_output = ((acc >> 12) >= pw) ? $fff : 0
calc_pulse_out:
        clr     a
        move    x:S_ACC,a1
        rep     #12
        lsr     a
        move    x:S_PW,x0
        cmp     x0,a
        jlt     cpo_low
        move    #>$fff,x0
        move    x0,x:S_PULSE
        rts
cpo_low:
        clr     a
        move    a1,x:S_PULSE
        rts

; noise_output: the eight scattered register bits 20,18,14,11,9,5,2,0 gathered
; into bits 11..4
set_noise_output:
        move    x:S_SR,x0
        clr     b
        jclr    #20,x0,sn_1
        move    #>$800,y0
        or      y0,b
sn_1:
        jclr    #18,x0,sn_2
        move    #>$400,y0
        or      y0,b
sn_2:
        jclr    #14,x0,sn_3
        move    #>$200,y0
        or      y0,b
sn_3:
        jclr    #11,x0,sn_4
        move    #>$100,y0
        or      y0,b
sn_4:
        jclr    #9,x0,sn_5
        move    #>$80,y0
        or      y0,b
sn_5:
        jclr    #5,x0,sn_6
        move    #>$40,y0
        or      y0,b
sn_6:
        jclr    #2,x0,sn_7
        move    #>$20,y0
        or      y0,b
sn_7:
        jclr    #0,x0,sn_8
        move    #>$10,y0
        or      y0,b
sn_8:
        move    b1,x:S_NOISE
        rts

; one shift: bit0 = bit22 ^ bit17, sr = ((sr << 1) | bit0) & $7fffff
clock_shift_register:
        move    x:S_SR,x0
        clr     b
        jclr    #22,x0,cs_1
        move    #>1,b
cs_1:
        jclr    #17,x0,cs_2
        move    #>1,y0
        eor     y0,b
cs_2:
        move    x0,a
        lsl     a
        move    b1,x0
        or      x0,a
        move    #>$7fffff,x0
        and     x0,a
        move    a1,x:S_SR
        jmp     set_noise_output

; Noise combined with another waveform writes the waveform back into the
; register: each of the eight tapped bits is cleared when the matching output
; bit (11..4) is clear; the noise output is ANDed with the waveform.
write_shift_register:
        move    x:S_WAVEOUT,x0
        move    x:S_SR,a
        jset    #11,x0,ws_1
        move    #>$efffff,y0
        and     y0,a
ws_1:
        jset    #10,x0,ws_2
        move    #>$fbffff,y0
        and     y0,a
ws_2:
        jset    #9,x0,ws_3
        move    #>$ffbfff,y0
        and     y0,a
ws_3:
        jset    #8,x0,ws_4
        move    #>$fff7ff,y0
        and     y0,a
ws_4:
        jset    #7,x0,ws_5
        move    #>$fffdff,y0
        and     y0,a
ws_5:
        jset    #6,x0,ws_6
        move    #>$ffffdf,y0
        and     y0,a
ws_6:
        jset    #5,x0,ws_7
        move    #>$fffffb,y0
        and     y0,a
ws_7:
        jset    #4,x0,ws_8
        move    #>$fffffe,y0
        and     y0,a
ws_8:
        move    a1,x:S_SR
        move    x:S_NOISE,a
        and     x0,a
        move    a1,x:S_NOISE
        rts

; do_pre_writeback(prev, current, is6581) -> a1 = 1 or 0
pre_writeback_check:
        move    x:S_TMPA,a
        move    #>8,x0
        cmp     x0,a
        jle     pw_no                   ; prev <= 8
        move    #>$c,x0
        cmp     x0,a
        jne     pw_chk6581
        move    x:<G_MODEL,b            ; prev == $c
        tst     b
        jeq     pw_no                   ; 6581: no
        move    x:S_WAVEFORM,a
        move    #>9,x0
        cmp     x0,a
        jeq     pw_chk6581
        move    #>$e,x0
        cmp     x0,a
        jne     pw_no
pw_chk6581:
        move    x:<G_MODEL,a
        tst     a
        jne     pw_yes                  ; 8580 stops here
        move    x:S_TMPA,a              ; 6581: triangle <-> saw switches do not
        move    #>3,x0
        and     x0,a
        move    a1,y0                   ; y0 = prev & 3
        move    x:S_WAVEFORM,a
        and     x0,a                    ; a = current & 3
        move    #>2,x0
        cmp     x0,a
        jne     pw_c1
        move    #>1,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
        jmp     pw_yes
pw_c1:
        move    #>1,x0
        cmp     x0,a
        jne     pw_yes
        move    #>2,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
pw_yes:
        move    #>1,a
        rts
pw_no:
        clr     a
        rts

; The waveform code from the tables: base[ix] & (pulse if the pulse bit) &
; (noise output if the noise bit), ix = acc >> 12, flipped at bit 11 when ring
; modulated by a source voice whose phase msb is clear. Triangle and saw are
; computed; the pulse alone and noise alone read $fff. The result is left in a1.
wave_core:
        clr     a
        move    x:S_ACC,a1
        rep     #12
        lsr     a
        move    x:S_RING,b
        tst     b
        jeq     wcore_noring
        move    x:SRC_ACC,x0
        jset    #23,x0,wcore_noring
        move    #>$800,x0
        eor     x0,a
wcore_noring:
        move    a1,x:S_TMPC             ; ix
        move    x:S_WAVEFORM,a
        move    #>7,x0
        and     x0,a
        tst     a
        jeq     wcore_fff               ; waveform & 7 == 0: noise alone
        move    #>1,x0
        cmp     x0,a
        jeq     wcore_tri
        move    #>2,x0
        cmp     x0,a
        jeq     wcore_saw
        move    #>3,x0
        cmp     x0,a
        jeq     wcore_t3
        move    #>4,x0
        cmp     x0,a
        jeq     wcore_fff               ; pulse alone: $fff & pulse
        move    #>5,x0
        cmp     x0,a
        jeq     wcore_t5
        move    #>6,x0
        cmp     x0,a
        jeq     wcore_t6
wcore_t7:
        move    x:S_TMPC,n1
        move    #>DSP_X_WAVE7,r1
        nop
        move    x:(r1+n1),a
        jmp     wcore_join
wcore_t6:
        move    x:S_TMPC,n1
        move    #>DSP_X_WAVE6,r1
        nop
        move    x:(r1+n1),a
        jmp     wcore_join
wcore_t5:
        move    x:S_TMPC,n1
        move    #>DSP_Y_WAVE5,r1
        nop
        move    y:(r1+n1),a
        jmp     wcore_join
wcore_t3:
        move    x:S_TMPC,n1
        move    #>DSP_Y_WAVE3,r1
        nop
        move    y:(r1+n1),a
        jmp     wcore_join
wcore_fff:
        move    #>$fff,a
        jmp     wcore_join
wcore_saw:
        move    x:S_TMPC,a
        jmp     wcore_join
wcore_tri:                              ; ((ix ^ (msb ? $7ff : 0)) & $7ff) << 1
        move    x:S_TMPC,a
        move    a1,x0
        move    #>$7ff,y0
        jclr    #11,x0,wcore_nofold
        eor     y0,a
wcore_nofold:
        and     y0,a
        lsl     a
wcore_join:
        move    x:S_WAVEFORM,x0
        jclr    #2,x0,wcore_nopulse
        move    x:S_PULSE,x0
        and     x0,a
wcore_nopulse:
        move    x:S_WAVEFORM,x0
        jclr    #3,x0,wcore_nonoise
        move    x:S_NOISE,x0
        and     x0,a
wcore_nonoise:
        rts

; after waveform_output is stored: the 6581 clears phase bits for saw
; combinations, and noise combinations write back into the register
wave_post:
        move    x:<G_MODEL,a
        tst     a
        jne     wp_noacc                ; 8580
        move    x:S_WAVEFORM,x0
        jclr    #1,x0,wp_noacc
        move    #>$d,y0
        move    x0,a
        and     y0,a
        tst     a
        jeq     wp_noacc
        move    x:S_WAVEOUT,a           ; acc &= (waveform_output << 12) | $7fffff
        rep     #12
        asl     a
        move    #>$7fffff,x0
        or      x0,a
        move    x:S_ACC,x0
        and     x0,a
        move    a1,x:S_ACC
wp_noacc:
        move    x:S_WAVEFORM,a
        move    #>8,x0
        cmp     x0,a
        jle     wp_done
        move    x:S_TEST,a
        tst     a
        jne     wp_done
        jsr     write_shift_register
wp_done:
        rts

; reSID WaveformGenerator::set_waveform_output(): used after a control write.
; It also maps noise + pulse through the model's noise_pulse function and
; recomputes pulse_output.
wave_set_output:
        jsr     wave_core
        move    a1,x:S_WAVEOUT
        move    x:S_WAVEFORM,b
        move    #>$c,y0
        and     y0,b
        cmp     y0,b
        jne     wso_post
        move    x:S_WAVEOUT,x0          ; noise_pulse
        move    x:<G_MODEL,a
        tst     a
        jne     wso_8580
        move    x0,a                    ; 6581: noise < $f00 ? 0 : n & (n<<1) & (n<<2)
        move    #>$f00,y0
        cmp     y0,a
        jge     wso_6581_hi
        clr     a
        jmp     wso_np_store
wso_6581_hi:
        lsl     a
        and     x0,a
        move    a1,y0
        move    x0,a
        lsl     a
        lsl     a
        and     x0,a
        and     y0,a
        jmp     wso_np_store
wso_8580:
        move    x0,a                    ; 8580: noise < $fc0 ? n & (n<<1) : $fc0
        move    #>$fc0,y0
        cmp     y0,a
        jge     wso_8580_hi
        lsl     a
        and     x0,a
        jmp     wso_np_store
wso_8580_hi:
        move    #>$fc0,a
wso_np_store:
        move    a1,x:S_WAVEOUT
wso_post:
        jsr     wave_post
        jsr     calc_pulse_out
        rts

; reSID set_waveform_output(delta_t): used every frame
calc_wave_code:
        jsr     wave_core
        move    a1,x:S_WAVEOUT
        jmp     wave_post

; ---- WaveformGenerator::clock(dt), dt = G_DTMIN cycles
wave_clock:
        move    x:S_TEST,a
        tst     a
        jne     wk_test
        move    x:S_ACC,y1              ; old phase, for the msb edge
        move    x:S_FREQ,x0             ; delta = freq * dt
        move    x:<G_DTMIN,y0
        mpy     x0,y0,a
        asr     a
        move    a0,x:S_DELTA
        move    a0,x0
        clr     a                       ; acc = (acc + delta) & $ffffff
        move    x:S_ACC,a0
        move    #0,x1
        add     x,a
        move    a0,x:S_ACC
        clr     b                       ; msb_rising: bit 23 clear before, set after
        jset    #23,y1,wk_msb_done
        move    x:S_ACC,x0
        jclr    #23,x0,wk_msb_done
        move    #>1,b
wk_msb_done:
        move    b1,x:S_MSB
        move    #>$100000,x0            ; noise register steps (reSID's shift loop)
        move    x0,x:S_SHIFTPER
wk_shift_loop:
        move    x:S_DELTA,a
        tst     a
        jeq     wk_shift_done
        move    x:S_SHIFTPER,x0
        cmp     x0,a
        jge     wk_shift_step           ; delta >= period: step
        move    a1,x:S_SHIFTPER         ; period = delta; stop unless a bit-19 edge is crossed
        move    a1,x0
        move    #>$080000,y0
        cmp     y0,a
        jgt     wk_big
        move    x:S_ACC,a               ; period <= $80000
        sub     x0,a
        jset    #19,a1,wk_shift_done    ; ((acc - period) & $80000) -> stop
        move    x:S_ACC,a
        jclr    #19,a1,wk_shift_done    ; !(acc & $80000) -> stop
        jmp     wk_shift_step
wk_big:
        move    x:S_ACC,a               ; period > $80000
        sub     x0,a
        jclr    #19,a1,wk_shift_step    ; !((acc - period) & $80000) -> step
        move    x:S_ACC,a
        jset    #19,a1,wk_shift_step    ; (acc & $80000) -> step
        jmp     wk_shift_done
wk_shift_step:
        jsr     clock_shift_register
        move    x:S_DELTA,a
        move    x:S_SHIFTPER,x0
        sub     x0,a
        move    a1,x:S_DELTA
        jmp     wk_shift_loop
wk_shift_done:
        jmp     calc_pulse_out          ; (tail call)
wk_test:
        move    x:S_SRRESET,a           ; test: the register reset countdown runs
        tst     a
        jeq     wk_test_pulse
        move    x:<G_DTMIN,x0
        sub     x0,a
        jgt     wk_srr_keep
        move    #>$7fffff,x0
        move    x0,x:S_SR
        jsr     set_noise_output
        clr     a
wk_srr_keep:
        move    a1,x:S_SRRESET
wk_test_pulse:
        move    #>$fff,x0
        move    x0,x:S_PULSE
        rts

; ---- the cycles until this voice's msb toggles, when the voice it syncs has
; sync enabled: dt_min = min(dt_min, ceil(delta / freq)), delta being the phase
; distance to the next msb change. The division is a search: ceil(delta/freq) <
; dt_min exactly when delta <= freq * (dt_min - 1).
sync_check:
        move    x:DST_SYNC,a
        tst     a
        jeq     sc_done
        move    x:S_FREQ,a
        tst     a
        jeq     sc_done
        clr     a                       ; delta = $800000 - (acc & $7fffff)
        move    x:S_ACC,a1
        move    #>$7fffff,x0
        and     x0,a
        clr     b
        move    #>$800000,b1
        sub     a,b                     ; b = delta
        move    x:<G_DTMIN,a
        move    #>1,x0
        sub     x0,a
        move    a1,y0
        move    x:S_FREQ,x0
        mpy     x0,y0,a                 ; freq * (dt_min - 1)
        asr     a
        move    a0,x0
        clr     a
        move    x0,a1
        cmp     b,a                     ; limit - delta
        jlt     sc_done                 ; no toggle within dt_min - 1 cycles
        clr     a                       ; smallest k with freq * k >= delta
        move    #0,r2
        move    x:S_FREQ,y0
sc_loop:
        move    (r2)+
        add     y0,a
        cmp     b,a
        jlt     sc_loop
        move    r2,x0
        move    x0,x:<G_DTMIN
sc_done:
        rts

; ---- hard sync: if this voice's msb rose and the voice it syncs has sync set
; (and this voice is not itself synced by a source whose msb also rose), the
; synced voice restarts its phase
synchronize:
        move    x:S_MSB,a
        tst     a
        jeq     sy_done
        move    x:DST_SYNC,a
        tst     a
        jeq     sy_done
        move    x:S_SYNC,a
        tst     a
        jeq     sy_do
        move    x:SRC_MSB,a
        tst     a
        jne     sy_done
sy_do:
        clr     a
        move    a1,x:DST_ACC
sy_done:
        rts

; ---- waveform output at the frame's end, then
; (wave DAC - zero) * envelope DAC into S_OUT
outstage:
        move    x:S_WAVEFORM,a
        tst     a
        jeq     os_floating
        jsr     calc_wave_code
        jmp     os_output
os_floating:
        move    x:S_TTL,a
        tst     a
        jeq     os_output
        move    x:<G_N,x0
        sub     x0,a
        jgt     os_ttl_keep
        clr     a
        move    a1,x:S_WAVEOUT
os_ttl_keep:
        move    a1,x:S_TTL
os_output:
        move    x:S_WAVEOUT,n1
        move    #>DSP_X_WAVE_DAC,r1
        nop
        move    x:(r1+n1),a
        move    x:<G_ZERO,x0
        sub     x0,a
        move    a1,x0
        move    x:S_ENVCNT,n1
        move    #>DSP_X_ENV_DAC,r1
        nop
        move    x:(r1+n1),y0
        mpy     x0,y0,a
        asr     a
        move    a0,x:S_OUT
        rts

; ---- EnvelopeGenerator::clock(dt), dt = S_TMPDT
env_clock:
        move    x:S_PIPE,a
        tst     a
        jeq     ec_nopipe
        move    x:S_NEXT,a
        tst     a
        jne     ec_p_rel
        clr     a                       ; next state ATTACK
        move    a1,x:S_STATE
        move    a1,x:S_HOLD
        move    x:S_ATTACK,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     ec_p_done
ec_p_rel:
        move    #>ST_RELEASE,x0
        cmp     x0,a
        jne     ec_p_done
        move    x0,x:S_STATE
        move    x:S_RELEASE,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
ec_p_done:
        clr     a
        move    a1,x:S_PIPE
ec_nopipe:
        move    x:S_RATEPER,a           ; rate_step = period - counter, +$7fff if <= 0
        move    x:S_RATECNT,x0
        sub     x0,a
        jgt     ec_step_ok
        move    #>$7fff,x0
        add     x0,a
ec_step_ok:
        move    a1,x:S_TMPSTEP
ec_loop:
        move    x:S_TMPDT,a
        tst     a
        jeq     ec_done
        move    x:S_TMPSTEP,x0
        cmp     x0,a
        jge     ec_step
        move    x:S_RATECNT,b           ; dt < rate_step: advance the counter and stop
        add     a,b
        jclr    #15,b1,ec_store
        move    #>1,x0
        add     x0,b
        move    #>$7fff,x0
        and     x0,b
ec_store:
        move    b1,x:S_RATECNT
ec_done:
        rts
ec_step:
        clr     b                       ; rate_counter = 0, dt -= rate_step
        move    b1,x:S_RATECNT
        sub     x0,a
        move    a1,x:S_TMPDT
        move    x:S_STATE,a
        tst     a
        jeq     ec_do_step              ; attack steps every period
        move    x:S_EXPCNT,a
        move    #>1,x0
        add     x0,a
        move    a1,x:S_EXPCNT
        move    x:S_EXPPER,x0
        cmp     x0,a
        jne     ec_next
ec_do_step:
        clr     a
        move    a1,x:S_EXPCNT
        move    x:S_HOLD,a
        tst     a
        jne     ec_next                 ; frozen at zero
        move    x:S_STATE,a
        tst     a
        jeq     ec_attack
        move    #>ST_DECSUS,x0
        cmp     x0,a
        jeq     ec_decsus
ec_dec:                                 ; release: env = (env - 1) & $ff
        move    x:S_ENVCNT,a
        move    #>1,x0
        sub     x0,a
        move    #>$ff,x0
        and     x0,a
        move    a1,x:S_ENVCNT
        jmp     ec_setexp
ec_decsus:                              ; decrement unless at the sustain level
        move    x:S_SUSTAIN,a
        move    a1,n1
        move    #>DSP_X_SUST_TAB,r1
        nop
        move    x:(r1+n1),x0
        move    x:S_ENVCNT,a
        cmp     x0,a
        jeq     ec_setexp
        jmp     ec_dec
ec_attack:
        move    x:S_ENVCNT,a
        move    #>1,x0
        add     x0,a
        move    #>$ff,x0
        and     x0,a
        move    a1,x:S_ENVCNT
        cmp     x0,a
        jne     ec_setexp
        move    #>ST_DECSUS,x0          ; reached $ff: decay
        move    x0,x:S_STATE
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
ec_setexp:                              ; exponential counter period by envelope value
        move    x:S_ENVCNT,a
        move    #>$ff,x0
        cmp     x0,a
        jeq     ec_e_1
        move    #>$5d,x0
        cmp     x0,a
        jeq     ec_e_2
        move    #>$36,x0
        cmp     x0,a
        jeq     ec_e_4
        move    #>$1a,x0
        cmp     x0,a
        jeq     ec_e_8
        move    #>$0e,x0
        cmp     x0,a
        jeq     ec_e_16
        move    #>$06,x0
        cmp     x0,a
        jeq     ec_e_30
        tst     a
        jne     ec_next
        move    #>1,x0                  ; zero: hold
        move    x0,x:S_HOLD
        jmp     ec_e_store
ec_e_1:
        move    #>1,x0
        jmp     ec_e_store
ec_e_2:
        move    #>2,x0
        jmp     ec_e_store
ec_e_4:
        move    #>4,x0
        jmp     ec_e_store
ec_e_8:
        move    #>8,x0
        jmp     ec_e_store
ec_e_16:
        move    #>16,x0
        jmp     ec_e_store
ec_e_30:
        move    #>30,x0
ec_e_store:
        move    x0,x:S_EXPPER
ec_next:
        move    x:S_RATEPER,a
        move    a1,x:S_TMPSTEP
        jmp     ec_loop
;@endvoice

        end
