; F030SID DSP kernel (template; tools/dsp/gen_sid_asm.py expands it to SID.ASM)
;
; The three voices of the reference model (src/ref/sid_ref.c), the filter, the
; mixer and the external filter, bit for bit against the C model. Frame by
; frame on host request (DSP_CMD_FRAME replies with the three voice outputs
; and the chip output). See docs/dsp-kernel.md.
;
; Loaded in two stages: a 512-word bootstrap (stage2_loader.asm) installs this
; sparse program, which extends into external P RAM, and jumps to P:$0000.
; The host then loads the tables with DSP_CMD_LOAD_X / DSP_CMD_LOAD_Y.
;
; The frame is built for the 326 cycles a 49.17 kHz codec frame has. Its code
; sits in internal P memory and is a straight line per voice:
;
;   phase A  envelope and oscillator. The envelope is a countdown to the next
;            rate step (S_REM); the phase is a 48-bit word (S_ACC: X = the top
;            12 bits, the waveform index; Y = the low 12 bits << 12) advanced
;            by one MAC and compared against S_THR, the next phase at which
;            something happens (a noise register step, the msb rising, the
;            wrap). Both fall out of line only when an event is due.
;   phase B  the output: a handler per voice, chosen when the control register
;            is written (S_WH), makes the waveform code; the DAC tables come
;            from the host already offset and scaled so that one MPY of
;            wave DAC by envelope DAC is the voice output.
;   mixer    routing by multiplies, the state-variable filter, the external
;            filter.
;
; Register conventions: a, b, x0, x1, y0, y1, r0, r1, n0, n1 are scratch
; (y holds the frame's cycle count during phase A); y1 holds the written
; value across the write_reg handlers; r2 points at the wave DAC; r0/n0 and
; r4-r6, n4, n5 belong to the mixer (r0 is loaded every frame); r3/m3 is
; the SSI transmit interrupt's ring pointer and nothing else may touch it.
; n3 is the transmit interrupt's step (0 or 1) and r7/m7 its step table's
; pointer; n6 is the stream write pointer.

        include 'ioequ.inc'
        include 'protocol.inc'

ST_ATTACK       equ     0
ST_DECSUS       equ     1
ST_RELEASE      equ     2

; Fractional part of the cycles per codec frame, Q24: SID_CYC_Q24 & $ffffff
; (SID_CYC_Q24 = 336175407 = 20.0376 * 2^24, see src/ref/sid_ref.h).
EPS_INC         equ     $09a12f

; X short globals ($00-$0f)
G_EPS           equ     $00             ; Q24 sample-instant fraction
G_SYNCANY       equ     $01             ; bit 1: some voice has its sync bit set
G_WREM          equ     $02             ; cycles from this frame's start to the first queued register write
G_HREM          equ     $03             ; stream: cycles the host has released for rendering (horizon - clock)
; The filter's coefficient block is read at short addresses in parallel moves, the
; routing and mode masks through r4 (Y memory), the states through r5/r6 (L memory).
F_A1            equ     $04             ; TPT coefficients, Q23 words (host-derived)
F_A2            equ     $05
F_A3            equ     $06
F_K4            equ     $07             ; k = 1/Q divided by 4
F_CC            equ     $08             ; (reserved config word; the coefficient stream passes over it)
F_FG            equ     $09             ; filter path gain, Q22 (config)
F_VK            equ     $0a             ; volume * mixer scale
F_LPW           equ     $0b             ; external low-pass coefficient
K20             equ     $0c             ; L: X = 20, Y = 20 << 11
K21             equ     $0d             ; L: X = 21, Y = 21 << 11
G_N             equ     $0e             ; L: X = cycles in this frame, Y = the same << 11
F_RT            equ     $0f             ; bit 0: some voice is routed through the filter
; Y short globals. $00-$08: mr0 md0 mr1 md1 mr2 md2 mlp mbp mhp, the voices' routed
; and direct weights and the mode weights, multiplied in so the routing needs no branches
K_EPSINC        equ     $09             ; EPS_INC
K_FFF           equ     $0a             ; $fff
K_7FF           equ     $0b             ; $7ff
; (X short, in the spare words of the voice blocks: see gen_sid_asm.py)
G_DT11          equ     $0f             ; sync frames: G_DTMIN << 11
T_D             equ     $1e             ; mixer temporaries (the spare Y words of the voice blocks)
T_X             equ     $1f
T_OUT           equ     $2e             ; the chip output
G_PRE           equ     $3f             ; sync frames: (cycles left - 1) << 11
K_HPW           equ     $2f             ; EXT_HP_W
; X globals outside the short range
G_ZERO          equ     $40             ; wave zero level (config; the host folds it into the DAC table)
G_TTLSTART      equ     $41             ; floating TTL start (config)
G_MODEL         equ     $42             ; 0 = 6581, 1 = 8580 (config)
G_SRSTART       equ     $43             ; shift register reset start (config)
; n3 is the transmit interrupt's; n6 holds the stream write pointer.
G_WRET          equ     $45             ; where a register write handler returns to
G_STREAM        equ     $46             ; nonzero: the SSI stream runs
G_DTMIN         equ     $3e             ; Y short: cycles of the current oscillator step
G_HOR           equ     $48             ; stream: the horizon as the host last gave it
; X:$49 is spare: the stream write pointer is kept in n6.
G_PLAIN         equ     $4a             ; stream: nonzero: no checksum (DSP_CMD_STREAM_PLAIN)
G_PRIMED        equ     $4b             ; stream: the ring reached its target once
G_FHEAD         equ     $4c             ; write queue: next entry out
G_FTAIL         equ     $4d             ; write queue: next entry in
; stream status, DSP_CMD_STREAM_READ index 0..7 (keep the order)
G_STAT          equ     $50
G_STARTED       equ     $50             ; the first frame has been released: the ring is in use
G_SUM           equ     $51             ; checksum of the rendered frames: sum = 3*sum + chip + v1 + v2 + v3
G_MINFILL       equ     $52             ; least ring fill seen once primed, in frames
G_FCNT          equ     $53             ; write queue entries
G_CYC           equ     $54             ; render clock, SID cycles mod 2^24
G_UNDER         equ     $55             ; times the transmitter overtook the renderer
G_TUE           equ     $56             ; bit 0: the SSI reported a transmit underrun
G_LAST          equ     $57             ; ring fill after the last rendered frame (status 7: the host adds
                                        ; what is still buffered at the endpoint to its timing)
F_WL            equ     $58             ; the filter outputs' gains / 2 (Q23, host-derived with the coefficients):
F_WB            equ     $59             ; low-pass, band-pass, high-pass,
F_WH            equ     $5a
F_WLEAK         equ     $5b             ; and the low-pass share in the high-pass output
; band-limiting (bl_corr and its callers)
G_JUMPW         equ     $5c             ; wave DAC word of code $fff less that of code 0 (set by CONFIG)
G_BLDAC         equ     $5d             ; the DAC word being corrected
G_STEP          equ     $6a             ; two words, 1 and 0: the transmit interrupt's steps through the ring (r7, modulo 2)
G_SLEFT         equ     $68             ; sync frames: the split frame's cycles left
G_SCNT          equ     $67             ; sync frames: cycles without a source's msb toggle (fr_sync)
G_BLPH          equ     $70             ; L: the phase at the sample instant
BL_CYC16        equ     1313185         ; SID cycles per frame, Q16 (SID_CYC_Q24 >> 8)
BL_MAXCNT       equ     2047*$fff       ; the edge countdown is kept in units of $fff, at most 2047 frames

; The stream's memory (external X, above the tables)
FIFO_BASE       equ     $2400           ; write queue: 1024 entries of cycle, register, value (to X:$2fff)
FIFO_END        equ     $3000
FIFO_SIZE       equ     1024
RING_BASE       equ     $3000           ; 4096 frames, one word each (to X:$3fff); the SSI interrupt reads it through r3/m3
RING_WORDS      equ     4096
RING_TARGET     equ     3584            ; render ahead until this many frames wait (72.9 ms)
WREM_IDLE       equ     $400000         ; G_WREM with nothing queued (re-armed when it runs out)

;@equates

F_FILT          equ     $c8             ; $17 low three bits: routing
F_MODE          equ     $c9             ; $18 high nibble: LP BP HP voice-3-off
F_VOL           equ     $ca
F_MIXK          equ     $cb             ; mixer scale, Q23 (config)
; 48-bit states: L memory, X = integer part, Y = fraction
F_S1            equ     $74             ; (below the polyBLEP table, which fills Y $7f-$ff)
F_S2            equ     $75
F_XL            equ     $76
F_XH            equ     $77
MASK_R          equ     $100000         ; routed voices enter divided by 4 (headroom)
MASK_D          equ     $400000
EXT_LP_W        equ     5182881         ; external 15.9 kHz low-pass, g/(1+g), Q23
EXT_HP_W        equ     8522            ; external 15.9 Hz high-pass

S_SHADOW        equ     $a8             ; 32-word register shadow

        org     p:$0000
        jmp     start

        org     p:$0010                 ; SSI transmit data: a fast interrupt. The ring holds one word
        movep   x:(r3)+n3,x:m_tx        ; per frame; n3 alternates between 0 and 1, so each word goes
        move    x:(r7)+,n3              ; out twice, as left and right. (r7 circles the two steps at
                                        ; G_STEP: a fast interrupt must leave the condition codes alone.)
        org     p:$0012                 ; SSI transmit data with underrun: clear TUE, note it
        jsr     ssi_underrun

        org     p:$0080                 ; P:$0040-$007f belongs to the stage-two loader

; ---------------------------------------------------------------- one frame
; (internal P memory: everything a normal frame executes ends below P:$0200)

cmd_frame:
        jsr     <frame
        jmp     <fr_done

frame:
        move    x:<G_EPS,a                      ; n = 20 + carry of the Q24 fraction. The fraction is loaded
        move    y:<K_EPSINC,x0                  ; sign-extended, so the carry out of its 24 bits is the
        add     x0,a        l:<K20,y            ; accumulator's carry. y1 = n, y0 = n << 11
        jcc     <fr_n
        move    l:<K21,y
fr_n:   move    a1,x:<G_EPS
        move    a1,x0                           ; eps >> 13 for the sample-instant phase (phase B)
        move    x:<K_400,x1
        mpy     x0,x1,b
        move    y:<K_7FF,x1
        and     x1,b
        move    b1,x:<G_EPS13
        move    y,l:<G_N
        move    x:<G_WREM,b                     ; a queued register write falls in this frame's cycles?
        sub     y1,b        #V0_OUT,r0
        jslt    <wr_due                         ; (returns b1 = the countdown, y)
        move    b1,x:<G_WREM
        jset    #1,x:<G_SYNCANY,fr_sync

; Phase A: envelope countdown and oscillator. y1 = n, y0 = n << 11.
fr_phase_a:
;@voice
        move    x:<S_REM,b                      ; cycles to the next rate step
        sub     y1,b        x:<S_FREQE,x0
        jsle    <envs                           ; it falls in this frame (returns b1 = S_REM, x0, y)
        move    l:<S_ACC,a
        mac     y0,x0,a     x:<S_THR,x1         ; phase += freq * n
        cmp     x1,a        b1,x:<S_REM
        jsge    <oscs                           ; a noise step, the msb or the wrap is reached
        move    a,l:<S_ACC
;@endvoice

; Phase B: waveform code, (wave DAC - zero) * envelope DAC into S_OUT. Plain
; triangle, saw and pulse are read at the sample instant (phase + freq * eps);
; saw and pulse count the frames down to the next edge window (S_BLCNT, in
; units of $fff) and fall out of line (bl_saw, bl_pulse) for the polyBLEP
; correction around an edge. y1 = eps >> 13 throughout.
fr_b:   move    x:<G_EPS13,y1
;@voice
vb:     move    x:<S_WH,r1
        move    l:<S_ACC,a                      ; a = ix : fraction
        jmp     (r1)
hpulse:                                         ; code = ix >= pw ? $fff : 0
        move    x:<S_FREQE,x0
        mac     y1,x0,a     y:<K_FFF,x1
        and     x1,a        x:<S_BLCNT,b        ; the phase at the sample instant, wrapped
        sub     x1,b        x:<S_PW,x0
        jlt     <bl_pulse                       ; an edge may be near
        move    #0,y0
        cmp     x0,a
        tge     x1,a
        tlt     y0,a
        jmp     <hbl
hsaw:                                           ; code = ix
        move    x:<S_FREQE,x0
        mac     y1,x0,a     y:<K_FFF,x1
        and     x1,a        x:<S_BLCNT,b
        sub     x1,b
        jlt     <bl_saw
        jmp     <hbl
hquiet:                                         ; plain waveform at envelope DAC zero
        clr     a
        move    a1,x:<S_OUT
        move    a1,x:<S_BLCNT            ; the first audible frame must reconsider its edge window
        jmp     <vbend
hfloat:                                         ; no waveform: the last code floats until its TTL runs out
        move    y:S_TTL,b
        move    x:<G_N,x0
        sub     x0,b
        jle     hf_exp                          ; (then hfdone takes over)
        move    b1,y:S_TTL
hfdone:
hf_go:  move    x:<S_WAVEOUT,a
        jmp     <hplain
hnoise:
        move    x:S_NEDGE,b             ; a noise edge at or below the phase: the register steps
        cmp     b,a
        jge     <hn_fast                ; (and comes back to hcode with the new noise output)
        move    y:<S_NOISE,a
hcode:  move    a1,x:<S_WAVEOUT                 ; (the fast triangle, saw and pulse leave S_WAVEOUT to wave_refresh)
        jmp     <hplain
htri:                                           ; ((ix ^ (msb ? $7ff : 0)) & $7ff) << 1
        move    x:<S_FREQE,x0
        mac     y1,x0,a     y:<K_7FF,x1
        jclr    #11,a1,ht_up
        eor     x1,a
ht_up:  and     x1,a
        move    a1,a                            ; (drop the fraction)
        asl     a
; The band-limited and ordinary outputs share their final multiply and
; fall through into the next voice. Non-BLEP handlers may overwrite BLCNT:
; they never consume it, and every control write resets it before selecting
; saw/pulse. This removes the extra return jump from every pulse/BLEP output.
hbl:
hplain: move    a1,n2
        move    x:<S_ENVDAC,y0
        move    x:(r2+n2),x0
hblm:   mpy     x0,y0,a     b1,x:<S_BLCNT
        move    a1,x:<S_OUT
vbend:
;@endvoice

; ------------------------------------------------ mixer, filter, external filter
; The spec is mix_output() in src/ref/sid_ref.c; every step below is one line
; of it. States are 48-bit (Q24) in L memory, coefficients 24-bit words. The
; routing is a multiply by the weights in Y memory (no branches), the
; coefficients ride on the ALU instructions, and r4/r5/r6 end balanced.
mix_frame:
        move    x:(r0)+n0,x0    y:(r4)+,y0      ; v0, mr0
        mpy     x0,y0,a         y:(r4)+,y1      ; md0
        mpy     x0,y1,b         x:(r0)+n0,x0  y:(r4)+,y0        ; v1, mr1
        mac     x0,y0,a         y:(r4)+,y1      ; md1
        mac     x0,y1,b         x:(r0)+n0,x0  y:(r4)+,y0        ; v2, mr2
        mac     x0,y0,a         y:(r4)-n4,y1    ; md2 (r4 back at mr0)
        mac     x0,y1,b
        asl     b                               ; b1 = direct sum
        asl     a               b1,y:<T_D       ; a1 = routed sum >> 2
        jclr    #0,x:<F_RT,mx_nofilt
        move    a1,y:<T_X
        move    a1,b                            ; b = x << 24
        move    x:(r5)+,y0                      ; s1h
        move    l:(r5),a                        ; s2
        sub     a,b             x:<F_A1,x0      ; h3 = x - s2; a1
        move    b1,y1                           ; v3h
        mpy     x0,y0,a         x:<F_A2,x0      ; a = a1*s1h; a2
        mac     x0,y1,a         l:(r5),b        ; v1 = + a2*v3h; b = s2
        mac     x0,y0,b         x:<F_A3,x0      ; + a2*s1h; a3
        mac     x0,y1,b         a1,y0           ; v2 = + a3*v3h; y0 = v1h
        move    b1,y1                           ; v2h
        asl     a
        asl     b
        move    l:(r5)-,x                       ; s2 (r5 back at s1)
        sub     x,b
        move    b,l:(r5+n5)                     ; s2 = 2*v2 - s2
        move    l:(r5),x
        sub     x,a
        move    a,l:(r5)                        ; s1 = 2*v1 - s1
        move    x:<F_K4,x0                      ; hp = x - 4*k4*v1h - v2h
        mpy     x0,y0,a         y:<T_X,b
        asl     a
        asl     a
        sub     a,b
        sub     y1,b            y:<6,x1         ; mlp
        mpy     x1,y1,a         y:<7,x1         ; v2h * mlp; mbp
        mac     x1,y0,a         y:<8,x1         ; + v1h * mbp; mhp
        move    b1,y0
        mac     x1,y0,a         x:<F_FG,y0      ; + hph * mhp; fg
        asl     a                               ; the selected outputs, summed
        move    a,x0                            ; t, through the limiter
        mpy     x0,y0,a
        asl     a
        asl     a
        asl     a               y:<T_D,b
        jmp     <mx_tail
mx_nofilt:
        clr     a               y:<T_D,b        ; idle: nothing routed
mx_tail:
        add     b,a             x:<F_VK,y0      ; direct + filtered
        move    a,x0                            ; mixed, limited
        mpy     x0,y0,a         l:(r6),x        ; Q24, 16-bit chip output scale; x = the external low-pass state
        sub     x,a             x:<F_LPW,y1
        move    a1,y0
        mpy     y0,y1,a
        add     x,a                             ; y
        tfr     a,b
        asl     a
        sub     x,a
        tfr     b,a             a,l:(r6)+       ; xl = 2*y - xl
        move    l:(r6),x                        ; external high-pass of y
        sub     x,a             y:<K_HPW,y1
        move    a1,y0
        mpy     y0,y1,a
        add     x,a                             ; y2
        sub     a,b                             ; y - y2
        asl     a
        sub     x,a
        rnd     b               a,l:(r6)-       ; xh = 2*y2 - xh
        move    b1,y:<T_OUT
mix_end:
        rts

        ; profiling mark: the frame is computed, the replies follow
fr_done:
        move    x:<V0_OUT,a             ; the three voice outputs
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:<V1_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:<V2_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    y:<T_OUT,a              ; and the chip output
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        ; (falls into the command loop)

main_loop:
        jset    #0,x:m_hsr,ml_cmd       ; HRDF: a command word arrived
        move    x:G_STREAM,a
        tst     a
        jeq     main_loop
        jmp     stream_step
ml_cmd: movep   x:m_hrx,a
        move    #>DSP_CMD_FRAME,x0
        cmp     x0,a
        jeq     cmd_frame
        move    #>DSP_CMD_WRITE_REG,x0
        cmp     x0,a
        jeq     cmd_write
        move    #>DSP_CMD_FILTER,x0
        cmp     x0,a
        jeq     cmd_filter
        move    #>DSP_CMD_LOAD_X,x0
        cmp     x0,a
        jeq     cmd_load
        move    #>DSP_CMD_LOAD_Y,x0
        cmp     x0,a
        jeq     cmd_load_y
        move    #>DSP_CMD_LOAD_X_HI,x0
        cmp     x0,a
        jeq     cmd_load_hi
        move    #>DSP_CMD_CONFIG,x0
        cmp     x0,a
        jeq     cmd_config
        move    #>DSP_CMD_PING,x0
        cmp     x0,a
        jeq     cmd_ping
        move    #>DSP_CMD_READ_REG,x0
        cmp     x0,a
        jeq     cmd_read
        move    #>DSP_CMD_RESET,x0
        cmp     x0,a
        jeq     cmd_reset
        move    #>DSP_CMD_STREAM_PUSH,x0
        cmp     x0,a
        jeq     cmd_stream_push
        move    #>DSP_CMD_STREAM_READ,x0
        cmp     x0,a
        jeq     cmd_stream_read
        move    #>DSP_CMD_STREAM_START,x0
        cmp     x0,a
        jeq     cmd_stream_start
        move    #>DSP_CMD_STREAM_STOP,x0
        cmp     x0,a
        jeq     cmd_stream_stop
        move    #>DSP_CMD_STREAM_PLAIN,x0
        cmp     x0,a
        jeq     cmd_stream_plain
reply_error:
        move    #>DSP_REPLY_ERROR,a
        jmp     reply
cmd_ping:
        move    #>DSP_REPLY_HELLO,a
        jmp     reply
cmd_reset:
        jsr     reset_state
reply_ok:
        clr     a
reply:                                  ; a1 = reply word
        jclr    #1,x:m_hsr,*            ; HTDE: host consumed the last reply
        movep   a1,x:m_htx
        jmp     main_loop

; ---------------------------------------------------------------- host side

cmd_load:                               ; address, count, words -> X memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r0)+
load_done:
        jmp     reply_ok

cmd_load_hi:                            ; address, count, words -> the upper twelve bits of the X words
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    #>$800,y0
        move    #>$fff,y1
        do      x1,load_hi_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        mpy     x0,y0,b                 ; b0 = the word << 12
        move    x:(r0),a
        and     y1,a        b0,x0
        or      x0,a
        move    a1,x:(r0)+
load_hi_done:
        jmp     reply_ok

cmd_load_y:                             ; address, count, words -> Y memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_y_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y:(r0)+
load_y_done:
        jmp     reply_ok


; ------------------------------------------------------------- the SSI stream
; The transmit interrupt plays a ring of 4096 frames; the command loop
; renders ahead of it whenever the host has nothing to say (stream_step),
; until RING_TARGET frames wait. Register writes arrive stamped with their SID
; cycle (mod 2^24), in order, with a horizon: the cycle up to which the host
; has delivered everything. A frame is rendered when its first cycle is below
; the horizon, and takes the queued writes below its last cycle + 1 first -
; the rule the gate's vectors are made with, so a stream is bit-identical to
; the frame-by-frame run of the same trace.

ssi_underrun:                           ; long interrupt: SSISR then TX clears TUE
        movep   x:m_sr,x:G_TUE+1
        movep   x:(r3)+n3,x:m_tx
        move    x:(r7)+,n3
        bset    #0,x:G_TUE
        rti

cmd_stream_plain:
        move    #>1,x0
        move    x0,x:G_PLAIN
        jmp     reply_ok

cmd_stream_start:
        clr     a
        move    #>G_WRET+1,r0
        rep     #$58-$46
        move    a,x:(r0)+               ; stream variables and status
        move    #>RING_BASE,r0
        move    #>RING_WORDS,x0
        rep     x0
        move    a,x:(r0)+
        move    #>RING_BASE,r3
        move    #>RING_WORDS-1,m3
        move    #>1,x0                  ; the transmitter's steps: 0 (now), 1, 0, 1, ...
        move    x0,x:G_STEP
        move    a1,x:G_STEP+1
        move    #>G_STEP,r7
        move    #>1,m7
        move    #0,n3
        move    r3,n6
        move    #>FIFO_BASE,x0
        move    x0,x:G_FHEAD
        move    x0,x:G_FTAIL
        move    #>$7fffff,x0
        move    x0,x:G_MINFILL
        move    #>WREM_IDLE,x0
        move    x0,x:<G_WREM
        move    #>1,x0
        move    x0,x:G_STREAM
        movep   #$1f8,x:m_pcc           ; Port C pins to the SSI
        movep   #0,x:m_crb
        movep   #$4100,x:m_cra          ; 16-bit words, two per frame
        movep   #$3000,x:m_ipr          ; SSI at priority 2
        movep   #$5a00,x:m_crb          ; network mode, transmitter and its interrupt on
        andi    #$fc,mr
        jmp     reply_ok

cmd_stream_stop:
        ori     #$03,mr
        movep   #0,x:m_crb
        move    #>$ffff,m3
        clr     a
        move    a1,x:G_STREAM
        move    a1,x:G_FCNT
        move    #>WREM_IDLE,x0
        move    x0,x:<G_WREM
        jmp     reply_ok

stream_clock:                           ; a1 = the render clock: horizon - released cycles (mod 2^24)
        move    x:G_HOR,a
        move    x:<G_HREM,x0
        sub     x0,a
        rts

cmd_stream_read:                        ; index -> status word
        jsr     stream_clock
        move    a1,x:G_CYC
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,n1
        move    #>G_STAT,r1
        nop
        move    x:(r1+n1),a
        jmp     reply

cmd_stream_push:                        ; count, count * (cycle, register, value), horizon -> queue entries free
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,a
        tst     a
        jeq     sp_hor
        move    x:G_FCNT,b
        add     x1,b
        move    b1,x:G_FCNT
        move    x:G_FTAIL,r1
        move    #>FIFO_END,x0
        do      x1,sp_in
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r1)+
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r1)+
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r1)+
        move    r1,a
        cmp     x0,a
        jne     sp_nowrap
        move    #>FIFO_BASE,r1
sp_nowrap:
        nop
        nop
sp_in:
        move    r1,x:G_FTAIL
        move    x:G_FHEAD,r1            ; the countdown to the queue's head
        jsr     stream_clock
        move    a1,x0
        move    x:(r1),a
        sub     x0,a
        move    a1,b                    ; (mod 2^24, signed)
        move    b1,x:<G_WREM
sp_hor: jclr    #0,x:m_hsr,*
        movep   x:m_hrx,a
        move    x:G_HOR,x0
        move    a1,x:G_HOR
        sub     x0,a
        move    a1,b                    ; the horizon's advance
        move    x:<G_HREM,a
        add     b,a
        move    a1,x:<G_HREM
        move    #>FIFO_SIZE,a
        move    x:G_FCNT,x0
        sub     x0,a
        jmp     reply

; A queued write is due: b = G_WREM - n < 0. Apply every write below the
; frame's end, then return b1 = the new head's countdown less n.
wr_due:
        move    x:G_FCNT,a
        tst     a
        jeq     wq_idle
        move    #>1,x0
        sub     x0,a
        move    a1,x:G_FCNT
        move    x:G_FHEAD,r1
        move    #>wq_next,x0
        move    x0,x:G_WRET
        move    x:(r1)+,x0
        move    x:(r1)+,x1
        move    x:(r1)+,y1
        move    r1,a
        move    #>FIFO_END,x0
        cmp     x0,a
        jne     wq_nowrap
        move    #>FIFO_BASE,r1
wq_nowrap:
        move    r1,x:G_FHEAD
        jmp     write_dispatch
wq_next:
        move    x:G_FCNT,a
        tst     a
        jeq     wq_idle
        move    x:G_FHEAD,r1
        jsr     stream_clock
        move    a1,x0
        move    x:(r1),a
        sub     x0,a
        move    a1,b
        move    x:<G_N,x0
        sub     x0,b
        jlt     wr_due
        jmp     wq_ret
wq_idle:
        move    #>WREM_IDLE,b
wq_ret: move    l:<G_N,y
        move    #V0_OUT,r0
        rts

; One step of the stream: render frames into the ring while there is room,
; the host's horizon allows and the host is silent.
stream_step:
        move    x:G_STARTED,a
        tst     a
        jne     ss_run
        move    x:<G_HREM,a             ; nothing released yet: the transmitter plays the empty ring
        tst     a
        jle     main_loop
        move    r3,a                    ; the first frame goes 256 frames (5.2 ms) ahead of the transmitter.
        move    #>RING_BASE-256,x0      ; Placed just ahead, the transmitter passed it while the first frame
                                        ; was computed and played a whole ring (83 ms) of silence first.
        sub     x0,a
        move    #>RING_WORDS-1,x0
        and     x0,a
        move    #>RING_BASE,x0
        add     x0,a
        move    a1,n6
        move    #>1,x0
        move    x0,x:G_STARTED
ss_run: move    r3,x0                   ; the transmitter's position
        move    n6,a
        sub     x0,a
        move    #>RING_WORDS-1,x0
        and     x0,a
        move    a1,a                    ; frames rendered ahead of it (the difference may have been negative)
        move    x:G_PRIMED,b
        tst     b
        jeq     ss_tgt
        move    x:G_LAST,x0
        cmp     x0,a
        jle     ss_ok
        move    x:G_UNDER,b             ; more than after the last frame: it wrapped past the write pointer
        move    #>1,x1
        add     x1,b
        move    b1,x:G_UNDER
ss_ok:  move    x:G_MINFILL,x0
        cmp     x0,a
        jge     ss_tgt
        move    a1,x:G_MINFILL
ss_tgt: move    a1,x:G_LAST
        move    #>RING_TARGET,b
        sub     a,b                     ; room, in frames
        jgt     ss_room
        move    #>1,x0
        move    x0,x:G_PRIMED
        jmp     main_loop
ss_room:
        move    n6,x0               ; frames in this run: the room, at most up to the ring's end
        move    #>RING_BASE+RING_WORDS,a
        sub     x0,a
        cmp     a,b
        tgt     a,b
        ; Bound the whole run by the released horizon. Every frame consumes
        ; at most 21 SID cycles; positive tails below 21 allow one last frame,
        ; exactly as the original per-frame G_HREM > 0 check did.
        move    x:<G_HREM,a
        tst     a
        jle     main_loop
        move    a1,x0
        move    #>399457,y0             ; floor(2^23 / 21): conservatively floor(horizon / 21)
        mpy     x0,y0,a
        move    #>1,x0
        cmp     x0,a
        tlt     x0,a
        cmp     a,b
        tgt     a,b
        move    b1,x0
        move    x:G_LAST,a
        add     b,a
        move    a1,x:G_LAST
        move    x:G_PLAIN,a
        tst     a
        jne     ss_plain
        do      x0,ss_end
        jset    #0,x:m_hsr,ss_break     ; the host calls
        jsr     <frame
        move    x:G_SUM,x1              ; checksum = 3 * checksum + chip + voices (mod 2^24)
        move    x1,a
        asl     a           y:<T_OUT,x0
        add     x1,a        x:<V0_OUT,y0
        add     x0,a        x:<V1_OUT,x1
        add     y0,a        x:<V2_OUT,y0
        add     x1,a
        add     y0,a
        move    a1,x:G_SUM
        move    #>$80,y0                ; the chip output, 16 bits, at the top of the SSI word: << 8 across
        mpy     x0,y0,a
        move    n6,r1   ; a1:a0, then through the limiter
        move    a1,b2
        move    a0,b1
        move    b,x:(r1)+               ; (the transmitter sends it as left and right)
        move    r1,n6
        move    x:<G_HREM,a
        move    x:<G_N,x0
        sub     x0,a
        move    a1,x:<G_HREM
ss_end:
        jmp     ss_wrap
ss_plain:                               ; the same run without the checksum
        do      x0,ss_pend
        jset    #0,x:m_hsr,ss_break
        jsr     <frame
        move    y:<T_OUT,x0
        move    #>$80,y0
        mpy     x0,y0,a
        move    n6,r1
        move    a1,b2
        move    a0,b1
        move    b,x:(r1)+
        move    r1,n6
        move    x:<G_HREM,a
        move    x:<G_N,x0
        sub     x0,a
        move    a1,x:<G_HREM
ss_pend:
        jmp     ss_wrap
ss_break:
        dc      $00008c                 ; enddo (written as data: the assembler wants it inside the loop's text)
        move    r3,x0                   ; the run ended early: what is ahead now
        move    n6,a
        sub     x0,a
        move    #>RING_WORDS-1,x0
        and     x0,a
        move    a1,a
        move    x:G_PRIMED,b
        tst     b
        jeq     ss_bok
        move    x:G_LAST,x0             ; more than the whole run would have left: the transmitter
        cmp     x0,a                    ; wrapped past the write pointer during the run
        jle     ss_bok
        move    x:G_UNDER,b
        move    #>1,x1
        add     x1,b
        move    b1,x:G_UNDER
ss_bok: move    a1,x:G_LAST
ss_wrap:
        move    n6,a                ; the write pointer wraps at the ring's end
        move    #>RING_BASE+RING_WORDS,x0
        cmp     x0,a
        jne     main_loop
        move    #>RING_BASE,x0
        move    x0,n6
        jmp     main_loop

; ============================================================================
; The frame's out-of-line side, per voice: the oscillator events and the
; envelope steps. Below P:$1000, so every jump here is the short form.

rate_lookup:                            ; a1 = nibble -> a = rate counter period
        move    a1,n1
        move    #>DSP_X_RATE_TAB,r1
        nop
        move    x:(r1+n1),a
        rts

; ---- polyBLEP (src/ref/sid_ref.c blep48). Distances are 48-bit phase words
; (acc << 12); D = freq * cycles per frame in phase units.

bl_wrap:                                ; the edge at phase 0: a = phase -> the signed distance to its nearer image
        move    #>$800,x1
        cmp     x1,a
        jlt     <bl_corr
        move    #>$1000,x1
        sub     x1,a

; a = signed distance to an edge, x0 = D -> a = the correction to the DAC word for an edge of height
; G_JUMPW (0 beyond two frames; G_BLHIT is set within). Clobbers b, x, y, r1, n1.
bl_corr:
        move    #0,y1                   ; y1 bit 0: the sample is before the edge
        tst     a
        jpl     <bc_abs
        neg     a
        move    #>1,y1
bc_abs: move    #>$1000,y0        ; D = 0 also rejects here: distance >= 0
        mpy     x0,y0,b                 ; 2 * D << 12: two frames
        cmp     b,a
        jge     <bc_zero
        bset    #0,x:<G_BLHIT
        rep     #11
        asl     a
        and     #$fe,ccr
        rep     #16
        div     x0,a                    ; a0 = pos: the distance in 1/64 frame, Q8
        move    a0,a
        move    #>$ffff,x1
        and     x1,a
        move    a1,x1
        move    #>$8000,y0
        mpy     x1,y0,a                 ; a1 = table index, a0 = fraction << 16
        move    a1,n1
        move    #>DSP_Y_BLEP,r1
        clr     b
        move    a0,b1
        lsr     b
        move    b1,y0                   ; fraction << 15
        lua     (r1)+n1,r1
        nop
        move    y:(r1)+,x0
        move    y:(r1),a
        sub     x0,a
        move    a1,x1
        mpy     x1,y0,a
        add     x0,a                    ; the step residual, interpolated
        move    a1,x0
        move    x:G_JUMPW,y0
        mpy     x0,y0,a
        move    a1,a
        jclr    #0,y1,bc_done
        neg     a
bc_done:
        rts
bc_zero:
        clr     a
        rts

; The same correction for a caller that has made bc_abs's test itself and
; knows the sign (blp_fast): a = the distance, 0 <= a < 2 * D << 12, x0 = D
; -> a = the correction's magnitude. Three shifts and 24 quotient bits are the
; same quotient as bc_abs's eleven and sixteen, with nothing above it in a0.
; Clobbers b, x, y, r1, n1.
bc_hit: rep     #3
        asl     a
        and     #$fe,ccr
        rep     #24
        div     x0,a                    ; a0 = pos
        move    a0,x1
        move    #>$8000,y0
        mpy     x1,y0,a                 ; a1 = table index, a0 = fraction << 16
        move    #DSP_Y_BLEP,r1
        move    a1,n1
        move    a0,a
        lsr     a
        lua     (r1)+n1,r1
        move    a1,y0                   ; fraction << 15
        move    y:(r1)+,x0
        move    y:(r1),a
        sub     x0,a
        move    a1,x1
        mpy     x1,y0,a
        add     x0,a                    ; the step residual, interpolated
        move    a1,x0
        move    x:G_JUMPW,y0
        mpy     x0,y0,a
        move    a1,a
        rts

; a = positive 48-bit phase distance to the next edge, x0 = D,
; y0 = min($7fffff, floor(4096 * 2^23 / (21 * freq))). Discarding the
; phase fraction and rounding the reciprocal down makes q <= distance /
; (21*freq), in oscillator phase units. K = max(0, q-2) is safe because
; K*21*freq + freq + 2*D <= distance: 2*D + freq < 42*freq.
; Thus every skipped sample stays outside the unchanged two-frame BLEP
; window, including the sample-instant jitter. Register writes and sync
; still invalidate the countdown. b1 returns K*$fff, capped at 2047 frames.
bl_frames:
        move    x0,b
        tst     b
        jeq     <bf_max
        move    a1,x1
        mpy     x1,y0,b
        move    b1,b
        move    #>2,x1
        sub     x1,b
        jle     <bf_zero
        move    #>2047,x1
        cmp     x1,b
        tgt     x1,b
        move    b1,x1
        move    #>$fff,y0
        mpy     x1,y0,b
        asr     b
        move    b0,b
        rts
bf_zero:
        clr     b
        rts
bf_max: move    #>BL_MAXCNT,b
        rts

; x0 = frequency -> b1 = countdown reciprocal. Called only on a frequency
; change; y1 (the written register byte) is preserved. The division is paid
; here once, rather than every time an oscillator leaves an edge window.
bl_recip:
        move    #>21,y0
        mpy     x0,y0,b
        asr     b
        move    b0,x0
        move    x0,b
        move    #>4096,x1
        cmp     x1,b
        jle     <br_cap
        move    x1,a
        and     #$fe,ccr
        rep     #24
        div     x0,a
        move    a0,b
        rts
br_cap: move    #>$7fffff,b
        rts

;@voice
; ---------------------------------------------------------------- oscillator
; The phase is the 48-bit word L:S_ACC = acc << 12: X = ix (acc >> 12, the
; waveform index), Y = the low twelve bits << 12. S_THR is the smallest ix at
; which a frame has more to do than add: ix = $800 while the msb is clear
; (S_MSB, for hard sync) or the wrap at $1000. Zero forces a visit: the clock
; after the msb rose clears S_MSB again (bit 0: msb_rising; bit 1: a hard sync
; latched the pulse output, see sync_reset).
;
; The noise register steps on each rising edge of acc bit 19 (ix = $80 mod
; $100, reSID's shift-period loop). The edges are not events of their own:
; S_NEDGE is the first one not yet applied, and whoever needs the register
; applies those the phase has passed. With the noise bit on that is the
; output handler, every frame (hnoise, hgen); with it off nothing reads the
; register, and oscs takes them eight at a time. A control write, a hard
; sync restart and the 6581's msb clear apply the rest first (noise_flush).

; The frame's out-of-line side: a = the new phase, not yet wrapped (S_ACC still
; holds the old one), x1 = S_THR <= a1. Returns a = the phase to store.
oscs:
        move    x:<S_ACC,b              ; the old ix
        move    a,l:<S_ACC
        move    #>$800,x0               ; msb_rising: clear before, set after
        move    #0,x1
        cmp     x0,b
        jge     <og_msb
        cmp     x0,a
        jlt     <og_msb
        move    #>1,x1
og_msb: move    x1,x:<S_MSB
        jmp     <og_lazy
og_store:
        move    b1,x:<S_THR
        move    l:<G_N,y
        rts

; The noise bit is off: nothing reads the register until the next control
; write, and the noise edges passed since the last visit are applied here,
; eight at a time (a visit adds eight, between two toggles):
; sr = (sr << 8) | (((sr >> 15) ^ (sr >> 10)) & $ff) is eight single shifts.
; Up to seven stay pending below the phase, so S_NEDGE may be negative after a wrap.
og_lazy:
        move    x:S_NEDGE,b
        jset    #3,x:<S_WAVEFORM,og_lzw ; (the noise bit is on: the output handler applies them every frame)
og_lz8: move    #>$700,x0
        add     x0,b                    ; the eighth edge from there
        cmp     b,a
        jlt     <og_lz1                 ; fewer than eight wait: they stay (noise_flush takes single ones)
        move    #>$100,x0
        add     x0,b
        move    b1,x:S_NEDGE
        move    y:<S_SR,x0
        move    #>$100,y0
        mpy     x0,y0,b                 ; b1 = sr >> 15
        move    b1,x1
        move    #>$2000,y0
        mpy     x0,y0,b                 ; b1 = sr >> 10
        eor     x1,b
        move    #>$ff,x1
        and     x1,b
        move    b1,x1                   ; the eight new bits
        move    #>$80,y0
        mpy     x0,y0,b                 ; b0 = sr << 8
        move    b0,b
        or      x1,b
        move    #>$7fffff,x1
        and     x1,b
        move    b1,y:<S_SR
        move    x:S_NEDGE,b
        jmp     <og_lz8
og_lz1: sub     x0,b
og_lzw: move    #>$1000,x0
        cmp     x0,a
        jlt     <og_lzs
        sub     x0,a
        sub     x0,b
        move    a1,x:<S_ACC
og_lzs: move    b1,x:S_NEDGE
        clr     b
        jset    #0,x:<S_MSB,og_store    ; the msb rose: come back next frame
        move    #>$800,x0
        move    #>$1000,b
        cmp     x0,a
        tlt     x0,b
        jmp     <og_store

; Apply the noise edges the phase has passed, before anything reads the
; register or moves the phase (shift keeps the noise output current while the
; noise bit is on). Preserves y.
noise_flush:
        move    l:<S_ACC,a
        move    x:S_NEDGE,b
nf_loop:
        cmp     b,a
        jlt     <nf_done
        move    b1,y:S_TMPE
        jsr     <shift
        move    y:S_TMPE,b
        move    #>$100,x0
        add     x0,b
        jmp     <nf_loop
nf_done:
        move    b1,x:S_NEDGE
        rts

; hnoise's own way there, for the one or two edges a frame can pass: a = the
; phase, b = S_NEDGE <= a. Straight-line steps (shift, without its gather), the
; gather into a, and on to hcode. More than two edges (the first frame after
; a silent stretch) take hn_step.
hn_fast:
        move    #>$100,x0
        add     x0,b
        cmp     b,a
        jge     <hn_two
        move    b1,x:S_NEDGE
        move    y:<S_SR,b
hn_one:
        asl     b
        jclr    #18,b1,hn1a
        bchg    #23,b1
hn1a:  jclr    #23,b1,hn1b
        bclr    #23,b1
        bset    #0,b1
hn1b:
        move    b1,x0
        clr     a           b1,y:<S_SR
        btst    #20,x0
        rol     a
        btst    #18,x0
        rol     a
        btst    #14,x0
        rol     a
        btst    #11,x0
        rol     a
        btst    #9,x0
        rol     a
        btst    #5,x0
        rol     a
        btst    #2,x0
        rol     a
        btst    #0,x0
        rol     a
        lsl     a
        lsl     a
        lsl     a
        lsl     a
        move    a1,y:<S_NOISE
        jmp     <hcode
hn_two: add     x0,b
        cmp     b,a
        jge     <hn_many
        move    b1,x:S_NEDGE
        move    y:<S_SR,b
        asl     b
        jclr    #18,b1,hn2a
        bchg    #23,b1
hn2a:  jclr    #23,b1,hn2b
        bclr    #23,b1
        bset    #0,b1
hn2b:
        jmp     <hn_one
hn_many:
        move    x:S_NEDGE,b
        jsr     <hn_step
        move    y:<S_NOISE,a
        jmp     <hcode

; The same for the output handlers of a voice with the noise bit on (hnoise,
; hgen): a = the phase, b = S_NEDGE <= a. The edges are counted, the register
; takes that many steps and the noise output is gathered once. Preserves y1.
hn_step:
        move    #0,r1
        move    #>$100,x0
hn_cnt: add     x0,b        (r1)+
        cmp     b,a
        jge     <hn_cnt
        move    b1,x:S_NEDGE
        move    y:<S_SR,b
        do      r1,hn_end
        asl     b                       ; (shift, without the gather)
        jclr    #18,b1,hn_a
        bchg    #23,b1
hn_a:   jclr    #23,b1,hn_b
        bclr    #23,b1
        bset    #0,b1
hn_b:   move    b1,y:<S_SR
hn_end:
        jmp     <set_noise_output

; S_THR for a phase a register write changed
thr_update:
        move    x:<S_ACC,a
        move    #>$80,x0
        add     x0,a
        move    #>$1f00,x1
        and     x1,a
        add     x0,a                    ; the next noise edge
        move    a1,x:S_NEDGE            ; (the caller has applied the ones before it: noise_flush)
        jset    #3,x:<S_TEST,thu_calc   ; (under the test bit the phase is held and S_MSB keeps its value)
        move    x:<S_MSB,b
        tst     b
        jeq     <thu_calc
        clr     a                       ; the next clock has S_MSB to clear
        move    a1,x:<S_THR
        rts
thu_calc:
        move    x:<S_ACC,b
        move    #>$800,x0
        and     x0,b
        add     x0,b                    ; the msb toggle or the wrap
        move    b1,x:<S_THR             ; (the noise edges are not events: og_lazy, noise_flush)
        rts

; noise_output: the eight scattered register bits 20,18,14,11,9,5,2,0 gathered
; into bits 11..4
set_noise_output:
        move    y:<S_SR,x0
        clr     b
        btst    #20,x0
        rol     b
        btst    #18,x0
        rol     b
        btst    #14,x0
        rol     b
        btst    #11,x0
        rol     b
        btst    #9,x0
        rol     b
        btst    #5,x0
        rol     b
        btst    #2,x0
        rol     b
        btst    #0,x0
        rol     b
        lsl     b
        lsl     b
        lsl     b
        lsl     b
        move    b1,y:<S_NOISE
        rts

; One step of the noise register: bit0 = bit22 ^ bit17, sr = ((sr << 1) | bit0) & $7fffff.
; The gather into the noise output follows only while the noise bit is on
; (wr_control catches up otherwise). Preserves a.
shift:
        move    y:<S_SR,b
        asl     b                       ; bit 23 = old bit 22, bit 18 = old bit 17
        jclr    #18,b1,sh_a
        bchg    #23,b1
sh_a:   jclr    #23,b1,sh_b
        bclr    #23,b1
        bset    #0,b1
sh_b:   move    b1,y:<S_SR
        jset    #3,x:<S_WAVEFORM,set_noise_output
        rts

; ---- phase B, the general output handlers (reSID's set_waveform_output(delta_t)
; through the tables)
hgen:                                   ; combined waveforms, ring-modulated triangle
        jclr    #3,x:<S_WAVEFORM,hg_nc
        move    x:S_NEDGE,b
        cmp     b,a
        jsge    <hn_step
hg_nc:
        move    y:S_WJ,r1
        move    x:<S_ACC,a
        jclr    #0,x:<S_RING,hg_go      ; ring modulation flips the index msb while the source's msb is clear
        jset    #11,x:<SRC_ACC,hg_go
        bchg    #11,a1
hg_go:  jsr     (r1)                    ; the table for waveform & 7
        jclr    #2,x:<S_WAVEFORM,hg_np
        jset    #1,x:<S_MSB,hg_lat      ; (a hard sync in the frame's last step latched the pulse level)
        move    x:<S_ACC,b              ; the pulse bit: zero below the pulse width
        move    x:<S_PW,x0
        cmp     x0,b
        jge     <hg_np
        clr     a
        jmp     <hg_np
hg_lat: move    y:S_PULSE,x0
        and     x0,a
hg_np:  jclr    #3,x:<S_WAVEFORM,hg_nn
        move    y:<S_NOISE,x0
        and     x0,a
hg_nn:  move    y:S_WF,b
        tst     b
        jeq     <hcode                  ; a1 = the code
        move    a1,x:<S_WAVEOUT         ; 6581 saw combination or noise combination
        jsr     wave_post
        move    x:<S_WAVEOUT,a
        jmp     <hplain
htest:                                  ; the test bit: the phase is held, the pulse high
        jsr     test_clock
        move    x:<S_WAVEFORM,a
        tst     a
        jeq     hft
        move    y:S_WJ,r1
        move    x:<S_ACC,a
        jclr    #0,x:<S_RING,ht_go
        jset    #11,x:<SRC_ACC,ht_go
        bchg    #11,a1
ht_go:  jsr     (r1)
        jmp     <hg_np

; ---- band-limiting, the out-of-line side: the countdown ran out, an edge may be
; within two frames. a = the phase at the sample instant, x1 = $fff.
bl_saw:
        move    a1,n2
        move    a,l:G_BLPH
        move    x:(r2+n2),x0            ; the DAC word of the code
        move    x0,x:G_BLDAC
        bclr    #0,x:<G_BLHIT
        move    y:S_BLD,x0
        jsr     bl_wrap                 ; the falling edge at the wrap
        move    x:G_BLDAC,b
        sub     a,b
        move    b1,x:G_BLDAC
        clr     b
        jset    #0,x:<G_BLHIT,bl_done    ; inside the window: come back next frame
        move    #>$1000,a               ; frames to the next wrap's window
        move    l:G_BLPH,b
        sub     b,a
        move    y:S_BLD,x0
        move    x:S_BLREC,y0
        jsr     bl_frames
bl_done:
        move    x:G_BLDAC,x0
        move    x:<G_EPS13,y1
        move    x:<S_ENVDAC,y0
        jmp     <hblm

bl_pulse:                               ; (x0 = pw)
        jset    #@V@+1,x:<G_BLHIT,blp_fast
blp_old:
        move    a,l:G_BLPH
        move    #0,n2
        cmp     x0,a
        jlt     blp_c
        move    x1,n2
blp_c:  bclr    #0,x:<G_BLHIT
        move    x:(r2+n2),x0
        move    x0,x:G_BLDAC
        move    x:<S_PW,a               ; pulse width 0: always high, no edges
        tst     a
        jne     blp_e
        move    #>BL_MAXCNT,b
        jmp     bl_done
blp_e:  move    l:G_BLPH,a              ; the rising edge at the pulse width: the nearer image
        move    x:<S_PW,x0
        sub     x0,a
        move    #>$800,x0
        cmp     x0,a
        jlt     blp_lo
        move    #>$1000,x0
        sub     x0,a
        jmp     blp_r
blp_lo: move    #>-$800,x0
        cmp     x0,a
        jge     blp_r
        move    #>$1000,x0
        add     x0,a
blp_r:  move    y:S_BLD,x0
        jsr     bl_corr
        move    x:G_BLDAC,b
        add     a,b
        move    b1,x:G_BLDAC
        move    l:G_BLPH,a              ; the falling edge at the wrap
        move    y:S_BLD,x0
        jsr     bl_wrap
        move    x:G_BLDAC,b
        sub     a,b
        move    b1,x:G_BLDAC
        clr     b
        jset    #0,x:<G_BLHIT,bl_done
        move    l:G_BLPH,b              ; frames to the nearer of the two windows ahead
        move    x:<S_PW,a
        sub     b,a                     ; to the pulse width
        jgt     blp_g
        move    #>$1000,x0
        add     x0,a
blp_g:  move    #>$1000,x0
        tfr     x0,b
        move    l:G_BLPH,x
        sub     x,b                     ; to the wrap
        cmp     b,a
        tgt     b,a
        move    y:S_BLD,x0
        move    x:S_BLREC,y0
        jsr     bl_frames
        jmp     bl_done

; The same for a pulse whose two edges are further apart than their windows
; (bl_sep): at most one edge is near, and the level says which two to look at.
; High: the rising edge behind (phase - pw) or the wrap ahead ($1000 - phase),
; the DAC word of $fff plus the correction. Low: the rising edge ahead or the
; wrap behind, the word of 0 less the correction. S_BLWC is above two frames'
; phase, so a distance at or beyond it is outside; inside, bc_abs's test
; decides, bc_hit makes the correction, and the rare frame the test rejects
; goes the long way.
blp_fast:
        move    a,l:G_BLPH
        move    x1,n2
        sub     x0,a        x:S_BLWC,x1
        jmi     <blp_fl
        cmp     x1,a
        jlt     <blp_fhh
        move    #>$1000,a
        move    l:G_BLPH,b
        sub     b,a
        cmp     x1,a
        jge     <blp_fhm
blp_fhh:
        move    y:S_BLD,x0
        move    #>$1000,y0              ; bc_abs's test: within two frames (D = 0 is not)
        mpy     x0,y0,b
        cmp     b,a
        jge     blp_slow
        jsr     <bc_hit
        move    x:(r2+n2),x0
        add     x0,a        x:<G_EPS13,y1
        move    a1,x0
        clr     b           x:<S_ENVDAC,y0
        jmp     <hblm
blp_fhm:
        move    y:S_BLD,x0
        move    x:S_BLREC,y0
        jsr     <bl_frames
        move    x:(r2+n2),x0
        move    x:<G_EPS13,y1
        move    x:<S_ENVDAC,y0
        jmp     <hblm
blp_fl: neg     a
        cmp     x1,a
        jlt     <blp_fll
        move    l:G_BLPH,b
        cmp     x1,b
        jge     <blp_flm
        tfr     b,a
blp_fll:
        move    y:S_BLD,x0
        move    #>$1000,y0
        mpy     x0,y0,b
        cmp     b,a
        jge     blp_slow
        jsr     <bc_hit
        move    x:(r2),b
        sub     a,b         x:<G_EPS13,y1
        move    b1,x0
        clr     b           x:<S_ENVDAC,y0
        jmp     <hblm
blp_flm:
        move    y:S_BLD,x0
        move    x:S_BLREC,y0
        jsr     <bl_frames
        move    x:(r2),x0
        move    x:<G_EPS13,y1
        move    x:<S_ENVDAC,y0
        jmp     <hblm
blp_slow:
        move    l:G_BLPH,a
        move    x:<S_PW,x0
        move    y:<K_FFF,x1
        jmp     blp_old

; S_BLWC = (D >> 11) + 1, in waveform index units: more than the two frames'
; phase (2 * D << 12) bl_corr looks at. The voice's bit in G_BLHIT says that
; 2 * S_BLWC < pw < $1000 - 2 * S_BLWC: the two edges' windows are apart, with
; room for S_BLWC's rounding. Called when the frequency or the pulse width
; changes; preserves y1.
bl_sep:
        move    y:S_BLD,x0
        move    #>$1000,y0
        mpy     x0,y0,b
        move    b1,b
        move    #>1,x0
        add     x0,b
        move    b1,x:S_BLWC
        asl     b
        bclr    #@V@+1,x:<G_BLHIT
        move    x:<S_PW,a
        cmp     b,a
        jle     <bls_no
        add     a,b
        move    #>$1000,x0
        cmp     x0,b
        jge     <bls_no
        bset    #@V@+1,x:<G_BLHIT
bls_no: rts

; the table routines: a1 = ix -> a1 = the waveform code before the pulse and noise masks
wt_t7:  move    a1,n1                   ; (tables 6 and 7 share their words: 7 is the upper twelve bits)
        move    #>DSP_X_WAVE7,r1
        move    #>$800,x1
        move    x:(r1+n1),x0
        mpy     x0,x1,a                 ; a1 = the word >> 12, sign-extended
        move    #>$fff,x0
        and     x0,a
        rts
wt_t6:  move    a1,n1
        move    #>DSP_X_WAVE6,r1
        move    #>$fff,x0
        move    x:(r1+n1),a
        and     x0,a
        rts
wt_t5:  move    a1,n1
        move    #>DSP_Y_WAVE5,r1
        nop
        move    y:(r1+n1),a
        rts
wt_t3:  move    a1,n1
        move    #>DSP_Y_WAVE3,r1
        nop
        move    y:(r1+n1),a
        rts
wt_fff:                                 ; noise alone, pulse alone
        move    #>$fff,a
        rts
wt_tri:                                 ; ((ix ^ (msb ? $7ff : 0)) & $7ff) << 1
        move    y:<K_7FF,y0
        jclr    #11,a1,wt_nofold
        eor     y0,a
wt_nofold:
        and     y0,a
        lsl     a
wt_saw: rts                             ; ix

; ------------------------------------------------------------------ envelope
; reSID EnvelopeGenerator::clock(dt). The rate counter is kept as the cycles
; left to its next step, S_REM (rate_step in the reference); the frame
; subtracts its cycle count and comes here when a step is due. The counter
; itself is S_CREF - S_REM (S_CREF = the period, or period + $7fff while the
; counter runs through its wrap: the ADSR delay bug). The exponential counter
; is the steps left to its period, S_EXPREM. The envelope value is a pointer
; into the host's table of (DAC word, exponential period) pairs, S_ENVP =
; DSP_X_ENV_TAB + 2 * value (DSP_X_ENV_TAB must be $200: bit 9).
;
; A gate change leaves the counter as a number (S_RATECNT) and S_REM = 0, so
; that the next frame comes here and eh_pipe applies the state change first.

envs:                                   ; b = S_REM - n <= 0: minus the cycles left after the step
        move    y:<S_EH,r1
        move    y:<S_RATEPER,x1
        jmp     (r1)

eh_hold:                                ; frozen at zero, or resting at the sustain level: only the rate counter
        move    x1,y:<S_CREF            ; and the exponential counter run. 240 steps leave both where they
        move    #>120,x0                ; are (the exponential period is 1, 2, 4, 8, 16 or 30), so they are
        mpy     x1,x0,a                 ; taken at once; env_unpark gives back the ones a register write
        move    a0,a                    ; finds not yet due
        add     a,b
        bset    #1,y:<S_HOLD
        move    x:<S_FREQE,x0
        rts
envret: move    x1,y:<S_CREF
envret2:
        move    x:<S_FREQE,x0
        move    l:<G_N,y
        rts

eh_release:
        move    y:<S_EXPREM,a
        move    #>1,x0
        sub     x0,a
        jne     <ed_keep                 ; the exponential counter has not reached its period
ed_dec: move    y:<S_ENVP,a             ; value = (value - 1) & $ff
        move    #>2,x0
        sub     x0,a
        move    #>$1fe,x0
        and     x0,a
        jmp     <env_set

eh_decsus:
        move    y:<S_ENVP,a
        move    y:<S_SUSP,x0
        cmp     x0,a
        jne     <ed_run
        move    #>eh_hold,x0            ; at the sustain level a step only turns the exponential counter:
        move    x0,y:<S_EH              ; the steps take the short way until a register write (env_handler)
        jmp     <eh_hold
ed_run: move    y:<S_EXPREM,a
        move    #>1,x0
        sub     x0,a
        jne     <ed_keep
        move    y:<S_ENVP,a
        move    y:<S_SUSP,x0
        cmp     x0,a
        jne     <ed_dec
        move    y:<S_EXPPER,a           ; at the sustain level only the exponential counter restarts
ed_keep:
        move    a1,y:<S_EXPREM
ed_next:
        add     x1,b                    ; the next step is a period away
        jle     <envs                    ; and falls in this frame too
        jmp     <envret

eh_attack:
        move    y:<S_ENVP,a
        move    #>2,x0
        add     x0,a
        move    #>$1fe,x0
        and     x0,a                    ; 2 * ((value + 1) & $ff)
        cmp     x0,a
        jne     <env_set
        move    #>ST_DECSUS,x0          ; $ff reached: decay
        move    x0,y:<S_STATE
        move    #>eh_decsus,x0
        move    x0,y:<S_EH
        move    y:S_DECAY,a
        jsr     <rate_lookup
        move    a1,y:<S_RATEPER
        move    a1,x1
        move    #>$1fe,a
env_set:                                ; a1 = 2 * the new value
        bset    #9,a1
        move    a1,y:<S_ENVP
        move    a1,r1
        nop
        move    x:(r1)+,x0              ; its DAC word
        move    x0,x:<S_ENVDAC
        move    x:(r1),a                ; the exponential counter period that starts at this value
        tst     a
        jeq     <es_same
        jmi     <es_zero
        move    a1,y:<S_EXPPER
        jmp     <es_rem
es_same:
        move    y:<S_EXPPER,a
es_rem: move    a1,y:<S_EXPREM
        jmp     <ed_next
es_zero:                                ; zero: period 1, frozen until the next attack
        move    #>1,x0
        move    x0,y:<S_EXPPER
        move    x0,y:<S_EXPREM
        move    x0,y:<S_HOLD
        move    #>eh_hold,x0
        move    x0,y:<S_EH
        jsr     output_handler
        jmp     <ed_next

eh_pipe:                                ; the gate changed: b = -n, the counter is in S_RATECNT
        move    y:S_NEXT,a
        tst     a
        jne     <ep_rel
        move    a1,y:<S_STATE           ; attack
        move    a1,y:<S_HOLD
        move    y:S_BASEWH,x0           ; attack may make a previously silent voice audible
        move    x0,x:<S_WH
        move    y:S_ATTACK,a
        jmp     <ep_rate
ep_rel: move    #>ST_RELEASE,x0
        move    x0,y:<S_STATE
        move    y:S_RELEASE,a
ep_rate:
        jsr     <rate_lookup
        move    a1,y:<S_RATEPER
        clr     a
        move    a1,y:<S_PIPE
        jsr     <env_handler
        move    y:<S_RATEPER,a          ; rate_step = period - counter; <= 0: the counter wraps first
        move    y:<S_RATECNT,x0
        sub     x0,a
        jgt     <ep_rs
        move    #>$7fff,x1
        add     x1,a
ep_rs:  add     a,b                     ; rate_step - n
        add     x0,a
        move    a1,y:<S_CREF
        tst     b
        jle     <envs                    ; the step falls in this frame
        jmp     <envret2

env_handler:                            ; S_EH for the pipeline, hold and state
        move    #>eh_pipe,x0
        jset    #1,y:<S_PIPE,eh_set
        move    #>eh_hold,x0
        jset    #0,y:<S_HOLD,eh_set
        move    #>eh_attack,x0
        move    y:<S_STATE,a
        tst     a
        jeq     <eh_set
        move    #>eh_decsus,x0
        jset    #0,y:<S_STATE,eh_set
        move    #>eh_release,x0
eh_set: move    x0,y:<S_EH
        rts

; eh_hold took 240 steps at once (S_HOLD bit 1); q = (S_REM - 1) / period of them are not due yet. Take them
; back: S_REM -= q * period, and the exponential counter turns back q steps. Keeps y1.
env_unpark:
        jclr    #1,y:<S_HOLD,eup_x
        bclr    #1,y:<S_HOLD
        move    x:<S_REM,a
        move    #>1,x0
        sub     x0,a
        move    a1,x1
        move    #>$8000,y0
        mpy     x1,y0,a                 ; (S_REM - 1) << 16
        move    y:<S_RATEPER,x0
        and     #$fe,ccr
        rep     #9
        div     x0,a                    ; a0 = q, 8 bits
        move    a0,a
        move    #>$1ff,x1
        and     x1,a
        move    a1,x1
        mpy     x1,x0,b
        asr     b
        move    b0,b                    ; q * period
        move    x:<S_REM,a
        sub     b,a
        move    a1,x:<S_REM
        move    y:<S_EXPPER,x0          ; steps left = (steps left - 1 + q) mod period + 1
        move    y:<S_EXPREM,a
        add     x1,a
        move    #>1,y0
        sub     y0,a
        move    #>30,b
        cmp     x0,b
        jeq     eup_30
        move    x0,b                    ; a power of two
        sub     y0,b
        move    b1,x0
        and     x0,a
        jmp     eup_set
eup_30: cmp     x0,a
        jlt     eup_set
        sub     x0,a
        jmp     eup_30
eup_set:
        add     y0,a
        move    a1,y:<S_EXPREM
eup_x:  rts

env_desync:                             ; S_RATECNT = the rate counter, S_REM = 0
        move    y:<S_CREF,a
        move    x:<S_REM,x0
        sub     x0,a
        move    #>$8000,x0              ; past the wrap: counter + 1 - $8000
        cmp     x0,a
        jlt     <eds_c
        move    #>$7fff,x0
        sub     x0,a
eds_c:  move    a1,y:<S_RATECNT
        clr     a
        move    a1,x:<S_REM
        rts

env_newper:                             ; a1 = the new rate period (a register write changed it)
        jset    #1,y:<S_PIPE,enp_store  ; a gate change is pending: eh_pipe does the rest
        move    a1,x1
        move    y:<S_CREF,a             ; the counter
        move    x:<S_REM,x0
        sub     x0,a
        move    #>$8000,x0
        cmp     x0,a
        jlt     <enp_c
        move    #>$7fff,x0
        sub     x0,a
enp_c:  move    a1,y0
        move    x1,y:<S_RATEPER
        tfr     x1,a
        sub     y0,a                    ; rate_step = period - counter; <= 0: the counter wraps first
        jgt     <enp_rs
        move    #>$7fff,x0
        add     x0,a
enp_rs: move    a1,x:<S_REM
        add     y0,a
        move    a1,y:<S_CREF
        rts
enp_store:
        move    a1,y:<S_RATEPER
        rts
;@endvoice

start:
        movep   #0,x:m_bcr              ; reset leaves external memory at 15 wait states
        movep   #1,x:m_pbc              ; enable the Falcon host port
        jsr     reset_state
        jmp     main_loop

cmd_config:                             ; wave zero, floating TTL, model, shift reset start, hp cancel, mixer scale, filter gain
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:G_ZERO
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:G_TTLSTART
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:G_MODEL
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:G_SRSTART
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_CC
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:F_MIXK
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_FG
        move    #>DSP_X_WAVE_DAC,r1     ; the tables are loaded by now: the pulse's DAC step,
        move    #>$fff,n1
        move    x:(r1),x0
        move    x:(r1+n1),a
        sub     x0,a
        move    a1,x:G_JUMPW
        jsr     env_refresh_0           ; and the envelope DAC words
        jsr     env_refresh_1
        jsr     env_refresh_2
        jmp     reply_ok

cmd_filter:                             ; a1, a2, a3, k4, wl, wb, wh, wleak (Q23 words, derived by the host)
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A1
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A2
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A3
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_K4
        move    #>F_WL,r0
        do      #4,cf_w
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r0)+
cf_w:
        jsr     update_masks
        jmp     reply_ok

cmd_read:                               ; reg -> shadow value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     reply_error
        move    x1,n1
        move    #>S_SHADOW,r1
        nop
        move    x:(r1+n1),a
        jmp     reply

cmd_write:                              ; reg, value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y1
        move    #>reply_ok,x0
        move    x0,x:G_WRET

; One register write: x1 = register, y1 = value; ends at wr_done, which
; returns through G_WRET. Registers 32-39 are not the SID's: they carry the
; filter coefficient words in the write queue.
write_dispatch:
        clr     b                       ; (the sync frames look again: fr_sync)
        move    b1,x:G_SCNT
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     wd_coef
        move    x1,n1
        move    #>S_SHADOW,r1
        nop
        move    y1,x:(r1+n1)            ; shadow for READ_REG
        move    x1,a
        move    #>21,x0
        cmp     x0,a
        jge     cw_filter               ; $15-$18: filter and mixer, then the read-only registers
        move    #>14,x0
        cmp     x0,a
        jlt     cw_not2
        sub     x0,a                    ; voice 3 (index 2)
        move    a1,x1
        jmp     write_reg_2
cw_not2:
        move    #>7,x0
        cmp     x0,a
        jlt     write_reg_0
        sub     x0,a
        move    a1,x1
        jmp     write_reg_1
wd_coef:                                ; 32-35: a1 a2 a3 k4; 36-39: wl wb wh wleak (the last one sets the weights)
        move    #>39,x0
        cmp     x0,a
        jgt     wr_done
        move    x1,n1
        move    #>F_A1-32,r1
        move    #>36,x0
        cmp     x0,a
        jlt     wd_store
        move    #>F_WL-36,r1
wd_store:
        nop
        move    y1,x:(r1+n1)
        move    #>39,x0
        cmp     x0,a
        jne     wr_done
        jsr     update_masks
wr_done:
        move    x:G_WRET,r1
        nop
        jmp     (r1)

cw_filter:                              ; a = reg (21..31), y1 = value. fc is the host's business:
        move    #>23,x0                 ; it only needs to be in the shadow.
        cmp     x0,a
        jeq     cw_resfilt
        move    #>24,x0
        cmp     x0,a
        jeq     cw_modevol
        jmp     wr_done
cw_resfilt:                             ; $17: routing in the low nibble
        move    #>7,x0
        move    y1,a
        and     x0,a
        move    a1,x:F_FILT
        jsr     update_masks
        jmp     wr_done
cw_modevol:                             ; $18: mode in the high nibble, volume in the low
        move    #>$0f,x0
        move    y1,a
        and     x0,a
        move    a1,y0
        move    a1,x:F_VOL
        move    x:F_MIXK,x0
        mpy     x0,y0,a                 ; volume * scale, as an integer
        asr     a
        move    a0,x:<F_VK
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:F_MODE
        jsr     update_masks
        jmp     wr_done

update_masks:                           ; routing and mode registers -> the Y weights, F_RT
        move    x:F_FILT,x1
        move    x:F_MODE,y1
        move    #0,r0
        move    #>MASK_R,x0
        move    #>MASK_D,y0
        clr     a
        jset    #0,x1,um_r0
        move    a1,y:(r0)+
        move    y0,y:(r0)+
        jmp     um_v1
um_r0:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_v1:  jset    #1,x1,um_r1
        move    a1,y:(r0)+
        move    y0,y:(r0)+
        jmp     um_v2
um_r1:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_v2:  jset    #2,x1,um_r2
        move    a1,y:(r0)+
        jset    #3,y1,um_d2off          ; voice 3 off mutes it unless routed
        move    y0,y:(r0)+
        jmp     um_mode
um_d2off:
        move    a1,y:(r0)+
        jmp     um_mode
um_r2:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_mode:                                ; the mode weights: each selected output's gain (gain / 2 words, from
        clr     a                       ; the host with the coefficients); the high-pass brings a share of the
        jclr    #0,y1,um_nlp            ; low-pass
        move    x:F_WL,a
um_nlp: jclr    #2,y1,um_nlk
        move    x:F_WLEAK,x0
        add     x0,a
um_nlk: move    a1,y:(r0)+              ; mlp
        clr     a
        jclr    #1,y1,um_nbp
        move    x:F_WB,a
um_nbp: move    a1,y:(r0)+              ; mbp
        clr     a
        jclr    #2,y1,um_nhp
        move    x:F_WH,a
um_nhp: move    a1,y:(r0)+              ; mhp
        clr     a
um_rt:  move    x1,a
        tst     a
        jne     um_routed
        move    a1,x:<F_RT             ; nothing routed: the filter is skipped, its integrators idle at zero
        move    a,l:F_S1
        move    a,l:F_S2
        rts
um_routed:
        move    #>1,x0
        move    x0,x:<F_RT
        rts

; ------------------------------------------------------- a frame with hard sync
; Some voice has its sync bit set: the oscillators are clocked in steps split
; at every msb toggle of a sync source (reSID SID::clock(delta_t)), so that a
; restart lands on its cycle. Most frames have no toggle and are one step.
fr_sync:
        ; G_SCNT: cycles in which no active sync source's msb can toggle
        ; (set below, cleared by every register write and every phase change
        ; outside the oscillator's own clock). While it lasts the frame is
        ; the ordinary one.
        move    x:G_SCNT,b
        sub     y1,b
        jlt     <fsy_chk
        move    b1,x:G_SCNT
        jmp     <fr_phase_a
fsy_chk:
        ; Without an MSB toggle of any active sync source, clocking all
        ; voices in one step is identical to the split loop. Predict only
        ; those sources; retain the original loop at every possible toggle.
;@voice
        jclr    #1,x:<DST_SYNC,fsg_next
        move    x:<S_FREQE,x0
        move    l:<S_ACC,a
        mac     y0,x0,a     x:<S_ACC,x1
        move    a1,b
        eor     x1,b
        ; At most 21*65535 phase units: less than one half-period.
        ; A changed bit 11 therefore detects every possible MSB toggle,
        ; including the wrap, without constructing the next threshold.
        jset    #11,b1,fr_sync_split
fsg_next:
;@endvoice
        ; No toggle in this frame. A source's toggle lies ceil(delta / freq)
        ; cycles ahead, delta being its phase distance to ix $800 or $1000.
        ; With d = that distance in whole ix less one (below delta) and
        ; S_BLREC <= 4096 * 2^23 / (21 * freq), 21 * ((d * S_BLREC) >> 23) is
        ; below delta / freq: for that many cycles the frames need no look.
        move    #>2047,b
;@voice
        jclr    #1,x:<DST_SYNC,fsb_next
        move    x:<S_ACC,x1
        move    #>$800,x0
        move    x1,a
        and     x0,a
        add     x0,a
        sub     x1,a        x:S_BLREC,y0
        move    #>1,x0
        sub     x0,a
        move    a1,x1
        mpy     x1,y0,a
        move    a1,a
        cmp     a,b
        tgt     a,b
fsb_next:
;@endvoice
        move    b1,x1
        move    #>21,y0
        mpy     x1,y0,b     x:<G_N,x0
        asr     b
        move    b0,b
        sub     x0,b        l:<G_N,y    ; (this frame is one of them)
        move    b1,x:G_SCNT
        jmp     <fr_phase_a
fr_sync_split:
        clr     b
        move    b1,x:G_SCNT
;@voice
        move    x:<S_REM,b
        sub     y1,b
        jsle    <envs
        move    b1,x:<S_REM
;@endvoice
        move    y0,a                    ; (n - 1) << 11
        move    #>$800,x0
        sub     x0,a
        move    a1,y:<G_PRE
        move    x:<G_N,a
fr_osc_loop:                            ; a1 = cycles left
        move    a1,x:G_SLEFT
        move    a1,y:<G_DTMIN
        move    y:<G_PRE,y0
;@voice
        jclr    #1,x:<DST_SYNC,sck_no   ; a sync source: can its msb toggle before the last cycle? S_THR is
        move    x:<S_FREQE,x0           ; at or below the toggle, so this test only lets through
        move    l:<S_ACC,a
        mac     y0,x0,a     x:<S_THR,x1
        cmp     x1,a
        jlt     sck_no
        jsr     sync_check
        move    y:<G_PRE,y0
sck_no:
;@endvoice
        move    y:<G_DTMIN,x0           ; the step's cycles << 11, the oscillators' multiplier
        move    #>$400,y0
        mpy     x0,y0,a     y:<G_PRE,b
        move    a0,y:<G_DT11
        move    a0,x0                   ; and what is left after it, less a cycle
        sub     x0,b
        move    b1,y:<G_PRE
;@voice
        move    x:<S_FREQE,x0           ; WaveformGenerator::clock(dt), as in the frame's phase A
        move    y:<G_DT11,y0
        move    l:<S_ACC,a
        mac     y0,x0,a     x:<S_THR,x1
        cmp     x1,a
        jsge    <oscs
        move    a,l:<S_ACC
;@endvoice
;@voice
        jclr    #0,x:<S_MSB,sy_done     ; hard sync: this voice's msb rose and the voice it syncs has sync set
        jclr    #1,x:<DST_SYNC,sy_done
        jclr    #1,x:<S_SYNC,sy_do      ; (and this voice was not itself restarted by a source whose msb also rose)
        jset    #0,x:<SRC_MSB,sy_done
sy_do:  jsr     sync_reset
sy_done:
;@endvoice
        move    x:G_SLEFT,a
        move    y:<G_DTMIN,x0
        sub     x0,a
        jne     fr_osc_loop
        jmp     fr_b

; ------------------------------------------------------------------- helpers

update_syncany:                         ; G_SYNCANY = some voice has sync set
        move    x:<V0_SYNC,a
        move    x:<V1_SYNC,x0
        or      x0,a
        move    x:<V2_SYNC,x0
        or      x0,a
        move    a1,x:<G_SYNCANY
        rts

reset_state:                            ; the model's power-on state
        clr     a
        move    #0,r0
        rep     #$88
        move    a,x:(r0)+               ; globals and the voices' X variables
        move    #>S_SHADOW,r0
        rep     #32
        move    a,x:(r0)+
        move    #$09,r0
        rep     #$76
        move    a,y:(r0)+               ; Y $09-$7e: constants, the voices' Y variables (the polyBLEP table follows)
        move    #>F_FILT,r0
        rep     #$21
        move    a,x:(r0)+               ; filter variables and states ($c8-$e8)
        move    #>F_S1,r0
        rep     #4
        move    a,y:(r0)+               ; the states' fractions
        move    #>20,x0                 ; the constants the frame reads from memory
        move    x0,x:<K20
        move    #>20*2048,x0
        move    x0,y:<K20
        move    #>21,x0
        move    x0,x:<K21
        move    #>21*2048,x0
        move    x0,y:<K21
        move    #>EPS_INC,x0
        move    x0,y:<K_EPSINC
        move    #>$fff,x0
        move    x0,y:<K_FFF
        move    #>$7ff,x0
        move    x0,y:<K_7FF
        move    #>$400,x0
        move    x0,x:<K_400
        move    #>EXT_HP_W,x0
        move    x0,y:<K_HPW
        move    #>EXT_LP_W,x0
        move    x0,x:<F_LPW
        move    #0,r4                   ; the pointers the frame keeps balanced
        move    #>F_S1,r5
        move    #>F_XL,r6
        move    #>HSIZE,n0
        move    #>WREM_IDLE,x0
        move    x0,x:<G_WREM
        move    #>5,n4
        move    #>1,n5
        move    #>DSP_X_WAVE_DAC,r2
        jsr     update_masks
        jsr     reset_voice_0
        jsr     reset_voice_1
        jsr     reset_voice_2
        rts

;@voice
; ============================================================ voice @V@
; Register writes: x1 = register within the voice (0..6), y1 = value

write_reg:
        move    x1,a
        tst     a
        jeq     wr_freq_lo
        move    #>1,x0
        cmp     x0,a
        jeq     wr_freq_hi
        move    #>2,x0
        cmp     x0,a
        jeq     wr_pw_lo
        move    #>3,x0
        cmp     x0,a
        jeq     wr_pw_hi
        move    #>4,x0
        cmp     x0,a
        jeq     wr_control
        move    #>5,x0
        cmp     x0,a
        jeq     wr_ad
        move    #>6,x0
        cmp     x0,a
        jeq     wr_sr
        jmp     wr_done

wr_freq_lo:
        move    y:S_FREQ,a
        move    #>$ff00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        jmp     wr_freq_set
wr_freq_hi:
        move    y:S_FREQ,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    b1,x0
        or      x0,a
wr_freq_set:
        move    y:S_FREQ,x0
        cmp     x0,a
        jeq     wr_done                 ; preserve the edge countdown on an unchanged frequency
        move    a1,y:S_FREQ
        move    a1,x0                   ; D = freq * cycles per frame, for the band-limiting
        move    #>BL_CYC16,y0
        mpy     x0,y0,b
        rep     #7
        asl     b
        move    b1,y:S_BLD
        jsr     bl_recip
        move    b1,x:S_BLREC
        jsr     bl_sep
        clr     b
        move    b1,x:<S_BLCNT
        jset    #3,x:<S_TEST,wr_done   ; the test bit holds the oscillator
        move    y:S_FREQ,x0
        move    x0,x:<S_FREQE
        jmp     wr_done

wr_pw_lo:
        jsr     wave_refresh
        move    x:<S_PW,a
        move    #>$f00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        move    x:<S_PW,x0
        cmp     x0,a
        jeq     wr_pw_same
        move    a1,x:<S_PW
        clr     b
        move    b1,x:<S_BLCNT
wr_pw_same:
        jsr     bl_sep
        jsr     calc_pulse_out
        jmp     wr_done

wr_pw_hi:
        jsr     wave_refresh
        move    x:<S_PW,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    #>$f00,x0
        and     x0,b
        move    b1,x0
        or      x0,a
        move    x:<S_PW,x0
        cmp     x0,a
        jeq     wr_pw_same
        move    a1,x:<S_PW
        clr     b
        move    b1,x:<S_BLCNT
        jmp     wr_pw_same

wr_ad:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,y:S_ATTACK
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,y:S_DECAY
        jsr     env_unpark
        move    y:<S_STATE,a
        tst     a
        jne     wad_notatk
        move    y:S_ATTACK,a
        jmp     wad_set
wad_notatk:
        move    #>ST_DECSUS,x0
        cmp     x0,a
        jne     wr_done
        move    y:S_DECAY,a
wad_set:
        jsr     rate_lookup
        jsr     env_newper
        jmp     wr_done

wr_sr:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,n1                   ; the sustain level as a pointer into the envelope table
        move    #>DSP_X_SUST_TAB,r1
        nop
        move    x:(r1+n1),a
        asl     a
        bset    #9,a1
        move    a1,y:<S_SUSP
        jsr     env_unpark
        jsr     env_handler             ; (a voice resting at the old level may decay again)
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,y:S_RELEASE
        move    y:<S_STATE,a
        move    #>ST_RELEASE,x0
        cmp     x0,a
        jne     wr_done
        move    y:S_RELEASE,a
        jsr     rate_lookup
        jsr     env_newper
        jmp     wr_done

; WaveformGenerator::writeCONTROL_REG, then EnvelopeGenerator's
wr_control:
        jsr     noise_flush                     ; the noise edges the phase has passed
        jset    #3,x:<S_WAVEFORM,wc_nfresh      ; the noise output is kept current only while
        jsr     set_noise_output                ; the noise bit is on,
wc_nfresh:
        jset    #3,x:<S_TEST,wc_pfresh          ; and the pulse output only under the test bit
        jset    #1,x:<S_MSB,wc_pfresh           ; or latched by a hard sync
        jsr     calc_pulse_out
wc_pfresh:
        jsr     wave_refresh                    ; (and the fast handlers leave S_WAVEOUT to this)
        clr     a
        move    a1,x:<S_BLCNT
        move    x:<S_WAVEFORM,a
        move    a1,y:S_TMPA             ; waveform_prev
        move    x:<S_TEST,a
        move    a1,y:S_TMPB             ; test_prev
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:<S_WAVEFORM
        move    y1,a
        move    #>8,x0
        and     x0,a
        move    a1,x:<S_TEST
        clr     a                       ; sync bit (1)
        move    a1,x:<S_SYNC
        jclr    #1,y1,wc_sync_done
        move    #>2,x0
        move    x0,x:<S_SYNC
wc_sync_done:
        jsr     update_syncany
        clr     a                       ; ring: bit 2 set and the saw bit (5) clear
        move    a1,x:<S_RING
        jset    #5,y1,wc_ring_done
        jclr    #2,y1,wc_ring_done
        move    #>1,x0
        move    x0,x:<S_RING
wc_ring_done:
        move    y:S_TMPB,a
        tst     a
        jne     wc_test_was_on
        jclr    #3,x:<S_TEST,wc_after_test
        clr     a                       ; test rising: phase 0 and held, shift register reset, pulse high
        move    a,l:<S_ACC
        move    a1,x:<S_FREQE
        bclr    #1,x:<S_MSB
        move    x:G_SRSTART,x0
        move    x0,y:S_SRRESET
        move    #>$fff,x0
        move    x0,y:S_PULSE
        jmp     wc_after_test
wc_test_was_on:
        jset    #3,x:<S_TEST,wc_after_test      ; test stays on
        move    y:S_FREQ,x0            ; test falling: the oscillator runs again
        move    x0,x:<S_FREQE
        jsr     pre_writeback_check     ; maybe write the waveform into the register
        tst     a
        jeq     wc_nowb
        jsr     write_shift_register
wc_nowb:
        move    y:<S_SR,x0              ; bit0 = (~sr >> 17) & 1; one shift
        clr     b
        jset    #17,x0,wc_bit0_done
        move    #>1,b
wc_bit0_done:
        move    x0,a
        lsl     a
        move    b1,x0
        or      x0,a
        move    #>$7fffff,x0
        and     x0,a
        move    a1,y:<S_SR
        jsr     set_noise_output
wc_after_test:
        jsr     set_handler
        move    x:<S_WAVEFORM,a
        tst     a
        jeq     wc_nowave
        jsr     wave_set_output
        jmp     wc_handler
wc_nowave:
        move    y:S_TMPA,a              ; waveform dropped to none: output floats
        tst     a
        jeq     wc_handler
        move    x:G_TTLSTART,x0
        move    x0,y:S_TTL
wc_handler:
        jsr     thr_update
        move    y1,a                    ; envelope gate
        move    #>1,x0
        and     x0,a
        move    a1,y:S_TMPA             ; gate_next
        move    y:S_GATE,x0
        cmp     x0,a
        jeq     wr_done
        jset    #1,y:<S_PIPE,wc_desynced
        jsr     env_unpark
        jsr     env_desync              ; the rate counter as a number: the period is about to change
wc_desynced:
        move    y:S_TMPA,a
        tst     a
        jeq     wc_release
        move    #>ST_ATTACK,x0
        move    x0,y:S_NEXT
        move    #>ST_DECSUS,x0
        move    x0,y:<S_STATE
        move    y:S_DECAY,a
        jsr     rate_lookup
        move    a1,y:<S_RATEPER
        jmp     wc_pipe
wc_release:
        move    #>ST_RELEASE,x0
        move    x0,y:S_NEXT
wc_pipe:
        move    #>2,x0
        move    x0,y:<S_PIPE
        move    y:S_TMPA,a
        move    a1,y:S_GATE
        move    #>eh_pipe,x0            ; the next frame's envelope step applies the state change
        move    x0,y:<S_EH
        jmp     wr_done

reset_voice:                            ; the voice's power-on state (its variables are already zero)
        move    #>hfloat,x0
        move    x0,x:<S_WH
        move    x0,y:S_BASEWH
        move    #>$555,x0               ; phase $555555
        move    x0,x:<S_ACC
        move    #>$555000,x0
        move    x0,y:<S_ACCF
        move    #>$580,x0
        move    x0,x:S_NEDGE
        move    #>$800,x0               ; (no waveform: the noise edges are applied at the toggles)
        move    x0,x:<S_THR
        move    #>$fff,x0
        move    x0,y:S_PULSE
        move    #>8,x0                  ; release rate 0, counter 0
        move    x0,y:<S_RATEPER
        move    x0,y:<S_CREF
        move    x0,x:<S_REM
        move    #>1,x0
        move    x0,y:<S_EXPPER
        move    x0,y:<S_EXPREM
        move    #>ST_RELEASE,x0
        move    x0,y:<S_STATE
        move    x0,y:S_NEXT
        move    #>eh_release,x0
        move    x0,y:<S_EH
        move    #>DSP_X_ENV_TAB+2*$aa,x0
        move    x0,y:<S_ENVP
        move    #>DSP_X_ENV_TAB,x0
        move    x0,y:<S_SUSP
        move    #>$7ffffe,x0
        move    x0,y:<S_SR
        jsr     env_refresh
        jmp     set_noise_output

env_refresh:                            ; S_ENVDAC from the table
        move    y:<S_ENVP,r1
        nop
        move    x:(r1),x0
        move    x0,x:<S_ENVDAC
        jmp     output_handler

; the output routines for the current waveform, ring and test bits: S_WH (the
; frame's handler), S_WJ (wave_core's table routine) and S_WF (wave_post's flags)
set_handler:
        clr     b
        move    x:<S_WAVEFORM,a
        move    #>8,x0
        cmp     x0,a
        jle     shf_acc
        move    #>2,b                   ; a noise combination writes back
shf_acc:
        move    x:G_MODEL,a
        tst     a
        jne     shf_store               ; 8580
        jclr    #1,x:<S_WAVEFORM,shf_store
        move    x:<S_WAVEFORM,a
        move    #>$d,x0
        and     x0,a
        jeq     shf_store
        bset    #0,b1                   ; a 6581 saw combination clears the phase msb
shf_store:
        move    b1,y:S_WF
        move    x:<S_WAVEFORM,a
        move    #>7,x0
        and     x0,a
        move    #>wt_fff,x1
        tst     a
        jeq     shj_store
        move    #>1,x0
        cmp     x0,a
        move    #>wt_tri,x1
        jeq     shj_store
        move    #>2,x0
        cmp     x0,a
        move    #>wt_saw,x1
        jeq     shj_store
        move    #>3,x0
        cmp     x0,a
        move    #>wt_t3,x1
        jeq     shj_store
        move    #>4,x0
        cmp     x0,a
        move    #>wt_fff,x1
        jeq     shj_store
        move    #>5,x0
        cmp     x0,a
        move    #>wt_t5,x1
        jeq     shj_store
        move    #>6,x0
        cmp     x0,a
        move    #>wt_t6,x1
        jeq     shj_store
        move    #>wt_t7,x1
shj_store:
        move    x1,y:S_WJ
        move    #>htest,x0
        jset    #3,x:<S_TEST,sh_store
        move    #>hgen,x0
        move    x:<S_WAVEFORM,a
        tst     a
        jeq     sh_float
        move    #>1,x1
        cmp     x1,a
        jeq     sh_tri
        move    #>2,x1
        cmp     x1,a
        jeq     sh_saw
        move    #>4,x1
        cmp     x1,a
        jeq     sh_pulse
        move    #>8,x1
        cmp     x1,a
        jne     sh_store
        move    #>hnoise,x0
        jmp     sh_store
sh_float:
        move    #>hfloat,x0
        jmp     sh_store
sh_tri:
        jset    #0,x:<S_RING,sh_store   ; ring modulated: the general path
        move    #>htri,x0
        jmp     sh_store
sh_saw:
        move    #>hsaw,x0
        jmp     sh_store
sh_pulse:
        move    #>hpulse,x0
sh_store:
        move    x0,y:S_BASEWH
output_handler:
        ; Only the stateless plain handlers can skip DAC/BLEP evaluation.
        ; Envelopes, oscillators, noise, sync and waveform side effects keep
        ; running; combined waveforms, test and floating outputs use their
        ; original handlers even at zero envelope.
        move    y:S_BASEWH,x0
        move    x:<S_ENVDAC,a
        tst     a
        jne     oh_store
        move    #>hpulse,a
        cmp     x0,a
        jeq     oh_quiet
        move    #>hsaw,a
        cmp     x0,a
        jeq     oh_quiet
        move    #>htri,a
        cmp     x0,a
        jeq     oh_quiet
        move    #>hfdone,a              ; (a floating output that has run out: nothing left to count)
        cmp     x0,a
        jne     oh_store
oh_quiet:
        move    #>hquiet,x0
oh_store:
        move    x0,x:<S_WH
        rts

; S_WAVEOUT is waveform_output as of the last frame. The frame's triangle, saw and
; pulse handlers do not store it (their code is the sample instant's): it is made
; here, before a write that could change what it would be.
wave_refresh:
        jset    #3,x:<S_TEST,wrf_done
        move    x:<S_WAVEFORM,a
        move    #>2,x0
        cmp     x0,a
        jeq     wrf_do
        move    #>4,x0
        cmp     x0,a
        jeq     wrf_do
        move    #>1,x0
        cmp     x0,a
        jne     wrf_done
        jset    #0,x:<S_RING,wrf_done
wrf_do: jset    #1,x:<S_MSB,wrf_core    ; (a latched pulse level stays)
        jsr     calc_pulse_out
wrf_core:
        jsr     wave_core
        move    a1,x:<S_WAVEOUT
wrf_done:
        rts

; pulse_output = ((acc >> 12) >= pw) ? $fff : 0
calc_pulse_out:
        clr     b
        move    x:<S_ACC,a
        move    x:<S_PW,x0
        cmp     x0,a        y:<K_FFF,y0
        tge     y0,b
        move    b1,y:S_PULSE
        rts

; Noise combined with another waveform writes the waveform back into the
; register: each of the eight tapped bits is cleared when the matching output
; bit (11..4) is clear; the noise output is ANDed with the waveform.
write_shift_register:
        move    x:<S_WAVEOUT,x0
        move    y:<S_SR,a
        jset    #11,x0,ws_1
        bclr    #20,a1
ws_1:
        jset    #10,x0,ws_2
        bclr    #18,a1
ws_2:
        jset    #9,x0,ws_3
        bclr    #14,a1
ws_3:
        jset    #8,x0,ws_4
        bclr    #11,a1
ws_4:
        jset    #7,x0,ws_5
        bclr    #9,a1
ws_5:
        jset    #6,x0,ws_6
        bclr    #5,a1
ws_6:
        jset    #5,x0,ws_7
        bclr    #2,a1
ws_7:
        jset    #4,x0,ws_8
        bclr    #0,a1
ws_8:
        move    a1,y:<S_SR
        move    y:<S_NOISE,a
        and     x0,a
        move    a1,y:<S_NOISE
        rts

; do_pre_writeback(prev, current, is6581) -> a1 = 1 or 0
pre_writeback_check:
        move    y:S_TMPA,a
        move    #>8,x0
        cmp     x0,a
        jle     pw_no                   ; prev <= 8
        move    #>$c,x0
        cmp     x0,a
        jne     pw_chk6581
        move    x:G_MODEL,b            ; prev == $c
        tst     b
        jeq     pw_no                   ; 6581: no
        move    x:<S_WAVEFORM,a
        move    #>9,x0
        cmp     x0,a
        jeq     pw_chk6581
        move    #>$e,x0
        cmp     x0,a
        jne     pw_no
pw_chk6581:
        move    x:G_MODEL,a
        tst     a
        jne     pw_yes                  ; 8580 stops here
        move    y:S_TMPA,a              ; 6581: triangle <-> saw switches do not
        move    #>3,x0
        and     x0,a
        move    a1,y0                   ; y0 = prev & 3
        move    x:<S_WAVEFORM,a
        and     x0,a                    ; a = current & 3
        move    #>2,x0
        cmp     x0,a
        jne     pw_c1
        move    #>1,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
        jmp     pw_yes
pw_c1:
        move    #>1,x0
        cmp     x0,a
        jne     pw_yes
        move    #>2,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
pw_yes:
        move    #>1,a
        rts
pw_no:
        clr     a
        rts


; The waveform code from the tables: base[ix] & (pulse if the pulse bit) &
; (noise output if the noise bit), ix = acc >> 12, flipped at bit 11 when ring
; modulated by a source voice whose phase msb is clear. Triangle and saw are
; computed; the pulse alone and noise alone read $fff. S_WJ is the routine for
; waveform & 7 (wt_*, chosen by set_handler). The result is left in a1.
wave_core:
        move    y:S_WJ,r1
        move    x:<S_ACC,a
        jclr    #0,x:<S_RING,wcore_go
        jset    #11,x:<SRC_ACC,wcore_go
        bchg    #11,a1
wcore_go:
        jsr     (r1)
        jclr    #2,x:<S_WAVEFORM,wcore_nopulse
        move    y:S_PULSE,x0
        and     x0,a
wcore_nopulse:
        jclr    #3,x:<S_WAVEFORM,wcore_nonoise
        move    y:<S_NOISE,x0
        and     x0,a
wcore_nonoise:
        rts

; after waveform_output is stored: the 6581 clears the phase msb for saw
; combinations (S_WF bit 0), and noise combinations write back into the
; register (S_WF bit 1)
wave_post:
        move    y:S_WF,x0
        jclr    #0,x0,wp_noacc
        jset    #11,x:<S_WAVEOUT,wp_noacc       ; acc &= (waveform_output << 12) | $7fffff: only the msb can go
        jclr    #11,x:<S_ACC,wp_noacc
        jsr     noise_flush             ; the noise edges up to the old phase
        clr     a
        move    a1,x:G_SCNT
        bclr    #11,x:<S_ACC
        jsr     thr_update
        move    y:S_WF,x0
wp_noacc:
        jclr    #1,x0,wp_done
        jset    #3,x:<S_TEST,wp_done
        move    x:<S_WAVEOUT,a          ; the noise output is the register's gathered bits: where the two
        move    y:<S_NOISE,x0           ; are equal the write-back has nothing to clear
        cmp     x0,a
        jne     write_shift_register
wp_done:
        rts

; reSID WaveformGenerator::set_waveform_output(): used after a control write.
; It also maps noise + pulse through the model's noise_pulse function and
; recomputes pulse_output.
wave_set_output:
        jsr     wave_core
        move    a1,x:<S_WAVEOUT
        move    x:<S_WAVEFORM,b
        move    #>$c,y0
        and     y0,b
        cmp     y0,b
        jne     wso_post
        move    x:<S_WAVEOUT,x0          ; noise_pulse
        move    x:G_MODEL,a
        tst     a
        jne     wso_8580
        move    x0,a                    ; 6581: noise < $f00 ? 0 : n & (n<<1) & (n<<2)
        move    #>$f00,y0
        cmp     y0,a
        jge     wso_6581_hi
        clr     a
        jmp     wso_np_store
wso_6581_hi:
        lsl     a
        and     x0,a
        move    a1,y0
        move    x0,a
        lsl     a
        lsl     a
        and     x0,a
        and     y0,a
        jmp     wso_np_store
wso_8580:
        move    x0,a                    ; 8580: noise < $fc0 ? n & (n<<1) : $fc0
        move    #>$fc0,y0
        cmp     y0,a
        jge     wso_8580_hi
        lsl     a
        and     x0,a
        jmp     wso_np_store
wso_8580_hi:
        move    #>$fc0,a
wso_np_store:
        move    a1,x:<S_WAVEOUT
wso_post:
        jsr     wave_post
        jsr     calc_pulse_out
        rts

; ---- the cycles until this voice's msb toggles (called when the voice it
; syncs has sync enabled): dt_min = min(dt_min, ceil(delta / freq)), delta being
; the phase distance to the next msb change. ceil(delta/freq) < dt_min exactly
; when the phase after dt_min - 1 cycles is at or past the toggle; only then is
; the count searched. (S_FREQE is zero under the test bit: the phase is held.)
sync_check:
        move    y:<G_DTMIN,a
        move    #>1,x0
        sub     x0,a
        move    a1,x0
        move    #>$400,y0
        mpy     x0,y0,a
        move    a0,y0                   ; (dt_min - 1) << 11
        move    x:<S_FREQE,x0
        move    l:<S_ACC,a
        mac     y0,x0,a                 ; the phase after dt_min - 1 cycles
        move    x:<S_ACC,b
        move    #>$800,x1
        and     x1,b
        add     x1,b                    ; the next toggle: ix = $800 or $1000
        cmp     b,a
        jlt     sc_done
        move    l:<S_ACC,a
        sub     a,b                     ; delta
        clr     a                       ; smallest k with freq * k >= delta (k <= 20): up in fours
        move    #0,r1                   ; until reached, then back down in ones
        move    #>4,n1
        move    #>$2000,y0
sc_loop:
        mac     y0,x0,a     (r1)+n1
        cmp     b,a
        jlt     sc_loop
        move    #>$800,y0
sc_back:
        mac     -y0,x0,a    (r1)-
        cmp     b,a
        jge     sc_back
        move    (r1)+
        nop
        move    r1,y:<G_DTMIN
sc_done:
        rts

; ---- hard sync: this voice restarts the phase of the voice it syncs. reSID
; computes pulse_output in clock(), before the restart: in the frame's last
; step that level is what the output stage sees, so it is latched (S_MSB bit 1)
; until the voice's next clock, which S_THR = 0 sends through oscs.
sync_reset:
        jsr     noise_flush_@D@         ; the noise edges it had passed
        move    #>$80,x0
        move    x0,x:DST_NEDGE
        move    x:G_SLEFT,a
        move    y:<G_DTMIN,x0
        cmp     x0,a
        jne     sr_clr
        jset    #3,x:<DST_TEST,sr_clr   ; (under the test bit the pulse is high anyway)
        clr     b
        move    x:<DST_ACC,a
        move    x:<DST_PW,x0
        cmp     x0,a        y:<K_FFF,y0
        tge     y0,b
        move    b1,y:DST_PULSE
        bset    #1,x:<DST_MSB
        clr     a
        move    a,l:<DST_ACC
        move    a1,x:<DST_THR
        move    a1,x:<DST_BLCNT
        rts
sr_clr: clr     a
        move    a,l:<DST_ACC
        move    a1,x:<DST_BLCNT
        jset    #0,x:<DST_MSB,sr_done   ; (its S_THR is 0 then, and stays)
        move    #>$800,x0
        move    x0,x:<DST_THR
sr_done:
        rts

; ------------------------------------------------------------ output, slow side
hf_exp:                                 ; the TTL ran out, or had before: the code is zero from here on,
        move    y:S_TTL,a               ; and the handler is hfdone (hquiet at envelope DAC zero)
        tst     a
        jeq     hfe_was
        clr     a
        move    a1,x:<S_WAVEOUT
        move    a1,y:S_TTL
hfe_was:
        move    #>hfdone,x0
        move    x0,y:S_BASEWH
        jsr     output_handler
        move    x:<G_EPS13,y1
        jmp     hf_go

; the same under the test bit (htest stays the handler)
hft:    move    y:S_TTL,b
        tst     b
        jeq     hf_go
        move    x:<G_N,x0
        sub     x0,b
        jgt     hft_keep
        clr     b
        move    b1,x:<S_WAVEOUT
hft_keep:
        move    b1,y:S_TTL
        jmp     hf_go

; test bit set: the register reset countdown runs, the pulse is high
test_clock:
        move    #>$fff,x0
        move    x0,y:S_PULSE
        move    y:S_SRRESET,a
        tst     a
        jeq     tc_done
        move    x:<G_N,x0
        sub     x0,a
        jgt     tc_keep
        move    #>$7fffff,x0
        move    x0,y:<S_SR
        jsr     set_noise_output
        clr     a
tc_keep:
        move    a1,y:S_SRRESET
tc_done:
        rts

;@endvoice

        end
