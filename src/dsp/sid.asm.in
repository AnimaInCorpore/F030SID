; F030SID DSP kernel (template; tools/dsp/gen_sid_asm.py expands it to SID.ASM)
;
; Milestone 3: the three voices of the reference model (src/ref/sid_ref.c), bit
; for bit against the C model: every waveform setting with noise and the
; combined waveforms, hard sync and ring modulation between the voices (each is
; synced and ring-modulated by the one before it), the test bit, the exact
; ADSR state machine, and the three 24-bit outputs
; (wave DAC - zero) * envelope DAC. Frame by frame on host request
; (DSP_CMD_FRAME replies with the three voice outputs). The filter, the mixer,
; band-limiting and the SSI stream follow in later milestones.
; See docs/dsp-kernel.md.
;
; Loaded in two stages: a 512-word bootstrap (stage2_loader.asm) installs this
; sparse program, which may extend into external P RAM, and jumps to P:$0000.
; The host then loads the tables with DSP_CMD_LOAD_X / DSP_CMD_LOAD_Y.
;
; Register conventions: a, b, x0, x1, y0, r0, r1, n0, n1 are scratch;
; y1 holds the written value across the write_reg handlers.

        include 'ioequ.inc'
        include 'protocol.inc'

ST_ATTACK       equ     0
ST_DECSUS       equ     1
ST_RELEASE      equ     2

; Fractional part of the cycles per codec frame, Q24: SID_CYC_Q24 & $ffffff
; (SID_CYC_Q24 = 336175407 = 20.0376 * 2^24, see src/ref/sid_ref.h).
EPS_INC         equ     $09a12f

; X internal globals ($00-$0f, short-addressed)
G_EPS           equ     $00             ; Q24 sample-instant fraction
G_ZERO          equ     $01             ; wave zero level (config)
G_TTLSTART      equ     $02             ; floating TTL start (config)
G_MODEL         equ     $03             ; 0 = 6581, 1 = 8580 (config)
G_SRSTART       equ     $04             ; shift register reset start (config)
G_N             equ     $05             ; cycles in this frame
G_DTOSC         equ     $06             ; cycles of the frame left to clock the oscillators
G_DTMIN         equ     $07             ; cycles of the current oscillator step

;@equates

; Filter, mixer and external filter (see src/ref/sid_ref.c, the executable spec).
; The coefficient block is read through r7 with parallel moves, the routing and
; mode masks through r4 (Y memory), the states through r5/r6 (L memory).
F_A1            equ     $08             ; TPT coefficients, Q23 words (host-derived)
F_A2            equ     $09
F_A3            equ     $0a
F_K4            equ     $0b             ; k = 1/Q divided by 4
F_CC            equ     $0c             ; high-pass cancellation (config)
F_FG            equ     $0d             ; filter path gain, Q22 (config)
F_VK            equ     $0e             ; volume * mixer scale
F_LPW           equ     $0f             ; external low-pass coefficient
T_X             equ     $e5             ; frame temporaries
T_D             equ     $e6
T_OUT           equ     $e7
F_RT            equ     $e8             ; bit 0: some voice is routed through the filter
G_SYNCANY       equ     $e4             ; nonzero when some voice has its sync bit set
F_FILT          equ     $c8             ; $17 low three bits: routing
F_MODE          equ     $c9             ; $18 high nibble: LP BP HP voice-3-off
F_VOL           equ     $ca
F_MIXK          equ     $cb             ; mixer scale, Q23 (config)
; 48-bit states: L memory, X = integer part, Y = fraction
F_S1            equ     $e0
F_S2            equ     $e1
F_XL            equ     $e2
F_XH            equ     $e3
; Y memory $00-$08: mr0 md0 mr1 md1 mr2 md2 mlp mbp mhp, the voices' routed and direct
; weights and the mode weights, multiplied in so the routing needs no branches
MASK_R          equ     $100000         ; routed voices enter divided by 4 (headroom)
MASK_D          equ     $400000
EXT_LP_W        equ     5182881         ; external 15.9 kHz low-pass, g/(1+g), Q23
EXT_HP_W        equ     8522            ; external 15.9 Hz high-pass

S_SHADOW        equ     $a8             ; 32-word register shadow

        org     p:$0000
        jmp     start

        org     p:$0080                 ; P:$0040-$007f belongs to the stage-two loader
start:
        movep   #0,x:m_bcr              ; reset leaves external memory at 15 wait states
        movep   #1,x:m_pbc              ; enable the Falcon host port
        jsr     reset_state

main_loop:
        jclr    #0,x:m_hsr,main_loop    ; HRDF: a command word arrived
        movep   x:m_hrx,a
        move    #>DSP_CMD_FRAME,x0
        cmp     x0,a
        jeq     cmd_frame
        move    #>DSP_CMD_WRITE_REG,x0
        cmp     x0,a
        jeq     cmd_write
        move    #>DSP_CMD_FILTER,x0
        cmp     x0,a
        jeq     cmd_filter
        move    #>DSP_CMD_LOAD_X,x0
        cmp     x0,a
        jeq     cmd_load
        move    #>DSP_CMD_LOAD_Y,x0
        cmp     x0,a
        jeq     cmd_load_y
        move    #>DSP_CMD_CONFIG,x0
        cmp     x0,a
        jeq     cmd_config
        move    #>DSP_CMD_PING,x0
        cmp     x0,a
        jeq     cmd_ping
        move    #>DSP_CMD_READ_REG,x0
        cmp     x0,a
        jeq     cmd_read
        move    #>DSP_CMD_RESET,x0
        cmp     x0,a
        jeq     cmd_reset
reply_error:
        move    #>DSP_REPLY_ERROR,a
        jmp     reply
cmd_ping:
        move    #>DSP_REPLY_HELLO,a
        jmp     reply
cmd_reset:
        jsr     reset_state
reply_ok:
        clr     a
reply:                                  ; a1 = reply word
        jclr    #1,x:m_hsr,*            ; HTDE: host consumed the last reply
        movep   a1,x:m_htx
        jmp     main_loop

; ---------------------------------------------------------------- host side

cmd_load:                               ; address, count, words -> X memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x:(r0)+
load_done:
        jmp     reply_ok

cmd_load_y:                             ; address, count, words -> Y memory
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,r0
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        do      x1,load_y_done
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y:(r0)+
load_y_done:
        jmp     reply_ok

cmd_config:                             ; wave zero, floating TTL, model, shift reset start
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_ZERO
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_TTLSTART
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_MODEL
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<G_SRSTART
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_CC
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:F_MIXK
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_FG
        jmp     reply_ok

cmd_filter:                             ; a1, a2, a3, k4 (Q23 words, derived by the host)
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A1
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A2
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_A3
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x0
        move    x0,x:<F_K4
        jmp     reply_ok

cmd_read:                               ; reg -> shadow value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     reply_error
        move    x1,n0
        move    #>S_SHADOW,r0
        nop
        move    x:(r0+n0),a
        jmp     reply

cmd_write:                              ; reg, value
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,x1
        jclr    #0,x:m_hsr,*
        movep   x:m_hrx,y1
        move    x1,a
        move    #>31,x0
        cmp     x0,a
        jgt     reply_ok                ; not a SID register
        move    x1,n0
        move    #>S_SHADOW,r0
        nop
        move    y1,x:(r0+n0)            ; shadow for READ_REG
        move    x1,a
        move    #>21,x0
        cmp     x0,a
        jge     cw_filter               ; $15-$18: filter and mixer, then the read-only registers
        move    #>14,x0
        cmp     x0,a
        jlt     cw_not2
        sub     x0,a                    ; voice 3 (index 2)
        move    a1,x1
        jmp     write_reg_2
cw_not2:
        move    #>7,x0
        cmp     x0,a
        jlt     write_reg_0
        sub     x0,a
        move    a1,x1
        jmp     write_reg_1

cw_filter:                              ; a = reg (21..31), y1 = value. fc is the host's business:
        move    #>23,x0                 ; it only needs to be in the shadow.
        cmp     x0,a
        jeq     cw_resfilt
        move    #>24,x0
        cmp     x0,a
        jeq     cw_modevol
        jmp     reply_ok
cw_resfilt:                             ; $17: routing in the low nibble
        move    #>7,x0
        move    y1,a
        and     x0,a
        move    a1,x:F_FILT
        jsr     update_masks
        jmp     reply_ok
cw_modevol:                             ; $18: mode in the high nibble, volume in the low
        move    #>$0f,x0
        move    y1,a
        and     x0,a
        move    a1,y0
        move    a1,x:F_VOL
        move    x:F_MIXK,x0
        mpy     x0,y0,a                 ; volume * scale, as an integer
        asr     a
        move    a0,x:<F_VK
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:F_MODE
        jsr     update_masks
        jmp     reply_ok

update_masks:                           ; routing and mode registers -> the Y weights, F_RT
        move    x:F_FILT,x1
        move    x:F_MODE,y1
        move    #0,r0
        move    #>MASK_R,x0
        move    #>MASK_D,y0
        clr     a
        jset    #0,x1,um_r0
        move    a1,y:(r0)+
        move    y0,y:(r0)+
        jmp     um_v1
um_r0:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_v1:  jset    #1,x1,um_r1
        move    a1,y:(r0)+
        move    y0,y:(r0)+
        jmp     um_v2
um_r1:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_v2:  jset    #2,x1,um_r2
        move    a1,y:(r0)+
        jset    #3,y1,um_d2off          ; voice 3 off mutes it unless routed
        move    y0,y:(r0)+
        jmp     um_mode
um_d2off:
        move    a1,y:(r0)+
        jmp     um_mode
um_r2:  move    x0,y:(r0)+
        move    a1,y:(r0)+
um_mode:
        jset    #0,y1,um_lp
        move    a1,y:(r0)+
        jmp     um_bp
um_lp:  move    y0,y:(r0)+
um_bp:  jset    #1,y1,um_bpon
        move    a1,y:(r0)+
        jmp     um_hp
um_bpon: move   y0,y:(r0)+
um_hp:  jset    #2,y1,um_hpon
        move    a1,y:(r0)+
        jmp     um_rt
um_hpon: move   y0,y:(r0)+
um_rt:  move    x1,a
        tst     a
        jne     um_routed
        move    a1,x:F_RT              ; nothing routed: the filter is skipped, its integrators idle at zero
        move    a,l:F_S1
        move    a,l:F_S2
        rts
um_routed:
        move    #>1,x0
        move    x0,x:F_RT
        rts

; ------------------------------------------------------------------- helpers

update_syncany:                         ; G_SYNCANY = some voice has sync set
        move    x:V0_SYNC,a
        move    x:V1_SYNC,x0
        or      x0,a
        move    x:V2_SYNC,x0
        or      x0,a
        move    a1,x:G_SYNCANY
        rts

rate_lookup:                            ; a1 = nibble -> a = rate counter period
        move    a1,n1
        move    #>DSP_X_RATE_TAB,r1
        nop
        move    x:(r1+n1),a
        rts

reset_state:                            ; the model's power-on state
        clr     a
        move    #0,r0
        rep     #$88
        move    a,x:(r0)+               ; globals and the three voice blocks
        move    #>S_SHADOW,r0
        rep     #32
        move    a,x:(r0)+
        move    #$10,r0
        rep     #66
        move    a,y:(r0)+               ; the voices' cold variables (Y $10-$51)
        move    #>F_FILT,r0
        rep     #$21
        move    a,x:(r0)+               ; filter variables and states ($c8-$e8)
        move    #>F_S1,r0
        rep     #4
        move    a,y:(r0)+               ; the states' fractions
        move    #>EXT_LP_W,x0
        move    x0,x:<F_LPW
        move    #0,r4                   ; the pointers mix_frame keeps balanced
        move    #>V0_OUT,r3
        move    #>F_S1,r5
        move    #>F_XL,r6
        move    #>F_A1,r7
        move    #>HSIZE,n3
        move    #>5,n4
        move    #>1,n5
        move    #>5,n7
        jsr     update_masks
        jsr     reset_voice_0
        jsr     reset_voice_1
        jsr     reset_voice_2
        rts

; ---------------------------------------------------------------- one frame

cmd_frame:
        clr     a                       ; n = 20 + carry of the Q24 fraction
        move    x:<G_EPS,a0
        move    #0,x1
        move    #>EPS_INC,x0
        add     x,a                     ; 48-bit add: a1 = carry, a0 = new fraction
        move    a0,x:<G_EPS
        move    a1,x0
        move    #>20,a
        add     x0,a
        move    a1,x:<G_N
        move    a1,x:<G_DTMIN
        jsr     env_clock_0
        jsr     env_clock_1
        jsr     env_clock_2
        move    x:G_SYNCANY,a
        tst     a
        jne     fr_sync_path
        jsr     wave_clock_0            ; no voice has sync set: one step of the whole frame
        jsr     wave_clock_1
        jsr     wave_clock_2
        jmp     fr_osc_done

fr_sync_path:
        move    x:<G_N,a
        move    a1,x:<G_DTOSC
fr_osc_loop:                            ; oscillators, split at every sync-source msb toggle
        move    x:<G_DTOSC,a
        move    a1,x:<G_DTMIN
        jsr     sync_check_0
        jsr     sync_check_1
        jsr     sync_check_2
        jsr     wave_clock_0
        jsr     wave_clock_1
        jsr     wave_clock_2
        jsr     synchronize_0
        jsr     synchronize_1
        jsr     synchronize_2
        move    x:<G_DTOSC,a
        move    x:<G_DTMIN,x0
        sub     x0,a
        move    a1,x:<G_DTOSC
        tst     a
        jne     fr_osc_loop
fr_osc_done:
        jsr     outstage_0
        jsr     outstage_1
        jsr     outstage_2
        jsr     mix_frame
        ; profiling mark: the frame is computed, the replies follow
fr_done:
        move    x:V0_OUT,a              ; the three voice outputs
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:V1_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:V2_OUT,a
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        move    x:T_OUT,a               ; and the chip output
        jclr    #1,x:m_hsr,*
        movep   a1,x:m_htx
        jmp     main_loop

; ------------------------------------------------ mixer, filter, external filter
; The spec is mix_output() in src/ref/sid_ref.c; every step below is one line
; of it. States are 48-bit (Q24) in L memory, coefficients 24-bit words. The
; routing is a multiply by the weights in Y memory (no branches), the
; coefficients stream through r7, and r4/r5/r6/r7 end balanced.
mix_frame:
        move    x:(r3)+n3,x0    y:(r4)+,y0      ; v0, mr0
        mpy     x0,y0,a         y:(r4)+,y1      ; md0
        mpy     x0,y1,b         x:(r3)+n3,x0  y:(r4)+,y0        ; v1, mr1
        mac     x0,y0,a         y:(r4)+,y1      ; md1
        mac     x0,y1,b         x:(r3)+n3,x0  y:(r4)+,y0        ; v2, mr2
        mac     x0,y0,a         y:(r4)-n4,y1    ; md2 (r4 back at mr0)
        mac     x0,y1,b
        asl     a                               ; a1 = routed sum >> 2
        asl     b                               ; b1 = direct sum
        move    b1,x:T_D
        move    #>V0_OUT,r3                     ; (balanced again for the next frame)
        move    x:F_RT,b
        tst     b
        jeq     mx_nofilt
        move    a1,x:T_X
        move    a1,b                            ; b = x << 24
        move    x:(r5)+,y0                      ; s1h
        move    l:(r5),a                        ; s2
        sub     a,b             x:(r7)+,x0      ; h3 = x - s2; a1
        move    b1,y1                           ; v3h
        mpy     x0,y0,a         x:(r7)+,x0      ; a = a1*s1h; a2
        mac     x0,y1,a         l:(r5),b        ; v1 = + a2*v3h; b = s2
        mac     x0,y0,b         x:(r7)+,x0      ; + a2*s1h; a3
        mac     x0,y1,b         a1,y0           ; v2 = + a3*v3h; y0 = v1h
        move    b1,y1                           ; v2h
        asl     a
        asl     b
        move    l:(r5)-,x                       ; s2 (r5 back at s1)
        sub     x,b
        move    b,l:(r5+n5)                     ; s2 = 2*v2 - s2
        move    l:(r5),x
        sub     x,a
        move    a,l:(r5)                        ; s1 = 2*v1 - s1
        move    x:(r7)+,x0                      ; hp = x - 4*k4*v1h - cc*v2h
        mpy     x0,y0,a         x:T_X,b
        asl     a
        asl     a
        sub     a,b             x:(r7)+,x0
        mac     -x0,y1,b        y:<6,x1         ; mlp
        mpy     x1,y1,a         y:<7,x1         ; v2h * mlp; mbp
        mac     x1,y0,a         y:<8,x1         ; + v1h * mbp; mhp
        move    b1,y0
        mac     x1,y0,a         x:(r7)-n7,y0    ; + hph * mhp; fg
        asl     a                               ; the selected outputs, summed
        move    a,x0                            ; t, through the limiter
        mpy     x0,y0,a
        asl     a
        asl     a
        asl     a
        jmp     mx_tail
mx_nofilt:
        clr     a                               ; idle: nothing routed
mx_tail:
        move    x:T_D,b
        add     b,a                             ; direct + filtered
        move    a,x0                            ; mixed, limited
        move    x:<F_VK,y0
        mpy     x0,y0,a                         ; Q24, 16-bit chip output scale
        move    l:(r6),x                        ; external low-pass
        sub     x,a
        move    a1,y0
        move    x:<F_LPW,y1
        mpy     y0,y1,a
        add     x,a                             ; y
        tfr     a,b
        asl     a
        sub     x,a
        move    a,l:(r6)+                       ; xl = 2*y - xl
        move    l:(r6),x                        ; external high-pass of y
        tfr     b,a
        sub     x,a
        move    a1,y0
        move    #>EXT_HP_W,y1
        mpy     y0,y1,a
        add     x,a                             ; y2
        sub     a,b                             ; y - y2
        asl     a
        sub     x,a
        move    a,l:(r6)-                       ; xh = 2*y2 - xh
        rnd     b
        move    b1,x:T_OUT
mix_end:
        rts

;@voice
; ============================================================ voice @V@
; Register writes: x1 = register within the voice (0..6), y1 = value

write_reg:
        move    x1,a
        tst     a
        jeq     wr_freq_lo
        move    #>1,x0
        cmp     x0,a
        jeq     wr_freq_hi
        move    #>2,x0
        cmp     x0,a
        jeq     wr_pw_lo
        move    #>3,x0
        cmp     x0,a
        jeq     wr_pw_hi
        move    #>4,x0
        cmp     x0,a
        jeq     wr_control
        move    #>5,x0
        cmp     x0,a
        jeq     wr_ad
        move    #>6,x0
        cmp     x0,a
        jeq     wr_sr
        jmp     reply_ok

wr_freq_lo:
        move    x:S_FREQ,a
        move    #>$ff00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        move    a1,x:S_FREQ
        jmp     reply_ok

wr_freq_hi:
        move    x:S_FREQ,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    b1,x0
        or      x0,a
        move    a1,x:S_FREQ
        jmp     reply_ok

wr_pw_lo:
        move    x:S_PW,a
        move    #>$f00,x0
        and     x0,a
        move    y1,x0
        or      x0,a
        move    a1,x:S_PW
        jsr     calc_pw12
        jsr     calc_pulse_out
        jmp     reply_ok

wr_pw_hi:
        move    x:S_PW,a
        move    #>$ff,x0
        and     x0,a
        move    y1,b
        rep     #8
        asl     b
        move    #>$f00,x0
        and     x0,b
        move    b1,x0
        or      x0,a
        move    a1,x:S_PW
        jsr     calc_pw12
        jsr     calc_pulse_out
        jmp     reply_ok

wr_ad:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_ATTACK
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,x:S_DECAY
        move    x:S_STATE,a
        tst     a
        jne     wad_notatk
        move    x:S_ATTACK,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok
wad_notatk:
        move    #>ST_DECSUS,x0
        cmp     x0,a
        jne     reply_ok
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok

wr_sr:
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_SUSTAIN
        move    y1,a
        move    #>$f,x0
        and     x0,a
        move    a1,x:S_RELEASE
        move    x:S_STATE,a
        move    #>ST_RELEASE,x0
        cmp     x0,a
        jne     reply_ok
        move    x:S_RELEASE,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     reply_ok

; WaveformGenerator::writeCONTROL_REG, then EnvelopeGenerator's
wr_control:
        move    x:S_WAVEFORM,a
        move    a1,x:S_TMPA             ; waveform_prev
        move    x:S_TEST,a
        move    a1,x:S_TMPB             ; test_prev
        move    y1,a
        rep     #4
        lsr     a
        move    a1,x:S_WAVEFORM
        move    y1,a
        move    #>8,x0
        and     x0,a
        move    a1,x:S_TEST
        clr     a                       ; sync bit (1)
        move    a1,x:S_SYNC
        jclr    #1,y1,wc_sync_done
        move    #>2,x0
        move    x0,x:S_SYNC
wc_sync_done:
        jsr     update_syncany
        clr     a                       ; ring: bit 2 set and the saw bit (5) clear
        move    a1,x:S_RING
        jset    #5,y1,wc_ring_done
        jclr    #2,y1,wc_ring_done
        move    #>1,x0
        move    x0,x:S_RING
wc_ring_done:
        jsr     set_handler
        move    x:S_TMPB,a
        tst     a
        jne     wc_test_was_on
        move    x:S_TEST,a              ; test off before
        tst     a
        jeq     wc_after_test
        clr     a                       ; test rising: phase 0, shift register reset, pulse high
        move    a1,x:S_ACC
        move    x:<G_SRSTART,x0
        move    x0,x:S_SRRESET
        move    #>$fff,x0
        move    x0,x:S_PULSE
        jmp     wc_after_test
wc_test_was_on:
        move    x:S_TEST,a
        tst     a
        jne     wc_after_test           ; test stays on
        jsr     pre_writeback_check     ; test falling: maybe write the waveform into the register
        tst     a
        jeq     wc_nowb
        jsr     write_shift_register
wc_nowb:
        move    x:S_SR,x0               ; bit0 = (~sr >> 17) & 1; one shift
        clr     b
        jset    #17,x0,wc_bit0_done
        move    #>1,b
wc_bit0_done:
        move    x0,a
        lsl     a
        move    b1,x0
        or      x0,a
        move    #>$7fffff,x0
        and     x0,a
        move    a1,x:S_SR
        jsr     set_noise_output
wc_after_test:
        move    x:S_WAVEFORM,a
        tst     a
        jeq     wc_nowave
        jsr     wave_set_output
        jmp     wc_env
wc_nowave:
        move    x:S_TMPA,a              ; waveform dropped to none: output floats
        tst     a
        jeq     wc_env
        move    x:<G_TTLSTART,x0
        move    x0,x:S_TTL
wc_env:
        move    y1,a                    ; envelope gate
        move    #>1,x0
        and     x0,a
        move    a1,x:S_TMPA             ; gate_next
        move    x:S_GATE,x0
        cmp     x0,a
        jeq     reply_ok
        tst     a
        jeq     wc_release
        move    #>ST_ATTACK,x0
        move    x0,x:S_NEXT
        move    #>ST_DECSUS,x0
        move    x0,x:S_STATE
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     wc_pipe
wc_release:
        move    #>ST_RELEASE,x0
        move    x0,x:S_NEXT
wc_pipe:
        move    #>2,x0
        move    x0,x:S_PIPE
        move    x:S_TMPA,a
        move    a1,x:S_GATE
        jmp     reply_ok

reset_voice:                            ; the voice's power-on state (its block is already zero)
        move    #>os_floating,x0
        move    x0,x:S_WH
        move    #>$555555,x0
        move    x0,x:S_ACC
        move    #>$fff,x0
        move    x0,x:S_PULSE
        move    #>$aa,x0
        move    x0,x:S_ENVCNT
        move    #>8,x0
        move    x0,x:S_RATEPER
        move    #>1,x0
        move    x0,x:S_EXPPER
        move    #>ST_RELEASE,x0
        move    x0,x:S_STATE
        move    x0,x:S_NEXT
        move    #>$7ffffe,x0
        move    x0,x:S_SR
        jmp     set_noise_output

; S_PW12 = pw << 12, kept beside the pulse width for the compare below
calc_pw12:
        move    x:S_PW,a
        rep     #12
        asl     a
        move    a1,x:S_PW12
        rts

; the waveform-code routine for the current waveform and ring bits
set_handler:
        move    x:S_WAVEFORM,a
        tst     a
        jeq     sh_float
        move    #>1,x0
        cmp     x0,a
        jeq     sh_tri
        move    #>2,x0
        cmp     x0,a
        jeq     sh_saw
        move    #>4,x0
        cmp     x0,a
        jeq     sh_pulse
        move    #>8,x0
        cmp     x0,a
        jeq     sh_noise
sh_gen:
        move    #>os_generic,x0
        jmp     sh_store
sh_float:
        move    #>os_floating,x0
        jmp     sh_store
sh_tri:
        move    x:S_RING,a
        tst     a
        jne     sh_gen                  ; ring modulated: the general path
        move    #>os_tri,x0
        jmp     sh_store
sh_saw:
        move    #>os_saw,x0
        jmp     sh_store
sh_pulse:
        move    #>os_pulse,x0
        jmp     sh_store
sh_noise:
        move    #>os_noise,x0
sh_store:
        move    x0,x:S_WH
        rts

; pulse_output = ((acc >> 12) >= pw) ? $fff : 0, i.e. acc >= pw << 12
calc_pulse_out:
        clr     b
        move    #>$fff,y0
        clr     a
        move    x:S_ACC,a0
        move    #0,x1
        move    x:S_PW12,x0
        sub     x,a                     ; acc - (pw << 12), both unsigned 24-bit
        tpl     y0,b
        move    b1,x:S_PULSE
        rts

; noise_output: the eight scattered register bits 20,18,14,11,9,5,2,0 gathered
; into bits 11..4
set_noise_output:
        move    x:S_SR,x0
        clr     b
        jclr    #20,x0,sn_1
        move    #>$800,y0
        or      y0,b
sn_1:
        jclr    #18,x0,sn_2
        move    #>$400,y0
        or      y0,b
sn_2:
        jclr    #14,x0,sn_3
        move    #>$200,y0
        or      y0,b
sn_3:
        jclr    #11,x0,sn_4
        move    #>$100,y0
        or      y0,b
sn_4:
        jclr    #9,x0,sn_5
        move    #>$80,y0
        or      y0,b
sn_5:
        jclr    #5,x0,sn_6
        move    #>$40,y0
        or      y0,b
sn_6:
        jclr    #2,x0,sn_7
        move    #>$20,y0
        or      y0,b
sn_7:
        jclr    #0,x0,sn_8
        move    #>$10,y0
        or      y0,b
sn_8:
        move    b1,x:S_NOISE
        rts

; one shift: bit0 = bit22 ^ bit17, sr = ((sr << 1) | bit0) & $7fffff
clock_shift_register:
        move    x:S_SR,x0
        clr     b
        jclr    #22,x0,cs_1
        move    #>1,b
cs_1:
        jclr    #17,x0,cs_2
        move    #>1,y0
        eor     y0,b
cs_2:
        move    x0,a
        lsl     a
        move    b1,x0
        or      x0,a
        move    #>$7fffff,x0
        and     x0,a
        move    a1,x:S_SR
        jmp     set_noise_output

; Noise combined with another waveform writes the waveform back into the
; register: each of the eight tapped bits is cleared when the matching output
; bit (11..4) is clear; the noise output is ANDed with the waveform.
write_shift_register:
        move    x:S_WAVEOUT,x0
        move    x:S_SR,a
        jset    #11,x0,ws_1
        move    #>$efffff,y0
        and     y0,a
ws_1:
        jset    #10,x0,ws_2
        move    #>$fbffff,y0
        and     y0,a
ws_2:
        jset    #9,x0,ws_3
        move    #>$ffbfff,y0
        and     y0,a
ws_3:
        jset    #8,x0,ws_4
        move    #>$fff7ff,y0
        and     y0,a
ws_4:
        jset    #7,x0,ws_5
        move    #>$fffdff,y0
        and     y0,a
ws_5:
        jset    #6,x0,ws_6
        move    #>$ffffdf,y0
        and     y0,a
ws_6:
        jset    #5,x0,ws_7
        move    #>$fffffb,y0
        and     y0,a
ws_7:
        jset    #4,x0,ws_8
        move    #>$fffffe,y0
        and     y0,a
ws_8:
        move    a1,x:S_SR
        move    x:S_NOISE,a
        and     x0,a
        move    a1,x:S_NOISE
        rts

; do_pre_writeback(prev, current, is6581) -> a1 = 1 or 0
pre_writeback_check:
        move    x:S_TMPA,a
        move    #>8,x0
        cmp     x0,a
        jle     pw_no                   ; prev <= 8
        move    #>$c,x0
        cmp     x0,a
        jne     pw_chk6581
        move    x:<G_MODEL,b            ; prev == $c
        tst     b
        jeq     pw_no                   ; 6581: no
        move    x:S_WAVEFORM,a
        move    #>9,x0
        cmp     x0,a
        jeq     pw_chk6581
        move    #>$e,x0
        cmp     x0,a
        jne     pw_no
pw_chk6581:
        move    x:<G_MODEL,a
        tst     a
        jne     pw_yes                  ; 8580 stops here
        move    x:S_TMPA,a              ; 6581: triangle <-> saw switches do not
        move    #>3,x0
        and     x0,a
        move    a1,y0                   ; y0 = prev & 3
        move    x:S_WAVEFORM,a
        and     x0,a                    ; a = current & 3
        move    #>2,x0
        cmp     x0,a
        jne     pw_c1
        move    #>1,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
        jmp     pw_yes
pw_c1:
        move    #>1,x0
        cmp     x0,a
        jne     pw_yes
        move    #>2,x0
        move    y0,b
        cmp     x0,b
        jeq     pw_no
pw_yes:
        move    #>1,a
        rts
pw_no:
        clr     a
        rts

; The waveform code from the tables: base[ix] & (pulse if the pulse bit) &
; (noise output if the noise bit), ix = acc >> 12, flipped at bit 11 when ring
; modulated by a source voice whose phase msb is clear. Triangle and saw are
; computed; the pulse alone and noise alone read $fff. The result is left in a1.
wave_core:
        clr     a
        move    x:S_ACC,a1
        rep     #12
        lsr     a
        move    x:S_RING,b
        tst     b
        jeq     wcore_noring
        move    x:SRC_ACC,x0
        jset    #23,x0,wcore_noring
        move    #>$800,x0
        eor     x0,a
wcore_noring:
        move    a1,x:S_TMPC             ; ix
        move    x:S_WAVEFORM,a
        move    #>7,x0
        and     x0,a
        tst     a
        jeq     wcore_fff               ; waveform & 7 == 0: noise alone
        move    #>1,x0
        cmp     x0,a
        jeq     wcore_tri
        move    #>2,x0
        cmp     x0,a
        jeq     wcore_saw
        move    #>3,x0
        cmp     x0,a
        jeq     wcore_t3
        move    #>4,x0
        cmp     x0,a
        jeq     wcore_fff               ; pulse alone: $fff & pulse
        move    #>5,x0
        cmp     x0,a
        jeq     wcore_t5
        move    #>6,x0
        cmp     x0,a
        jeq     wcore_t6
wcore_t7:
        move    x:S_TMPC,n1
        move    #>DSP_X_WAVE7,r1
        nop
        move    x:(r1+n1),a
        jmp     wcore_join
wcore_t6:
        move    x:S_TMPC,n1
        move    #>DSP_X_WAVE6,r1
        nop
        move    x:(r1+n1),a
        jmp     wcore_join
wcore_t5:
        move    x:S_TMPC,n1
        move    #>DSP_Y_WAVE5,r1
        nop
        move    y:(r1+n1),a
        jmp     wcore_join
wcore_t3:
        move    x:S_TMPC,n1
        move    #>DSP_Y_WAVE3,r1
        nop
        move    y:(r1+n1),a
        jmp     wcore_join
wcore_fff:
        move    #>$fff,a
        jmp     wcore_join
wcore_saw:
        move    x:S_TMPC,a
        jmp     wcore_join
wcore_tri:                              ; ((ix ^ (msb ? $7ff : 0)) & $7ff) << 1
        move    x:S_TMPC,a
        move    a1,x0
        move    #>$7ff,y0
        jclr    #11,x0,wcore_nofold
        eor     y0,a
wcore_nofold:
        and     y0,a
        lsl     a
wcore_join:
        move    x:S_WAVEFORM,x0
        jclr    #2,x0,wcore_nopulse
        move    x:S_PULSE,x0
        and     x0,a
wcore_nopulse:
        move    x:S_WAVEFORM,x0
        jclr    #3,x0,wcore_nonoise
        move    x:S_NOISE,x0
        and     x0,a
wcore_nonoise:
        rts

; after waveform_output is stored: the 6581 clears phase bits for saw
; combinations, and noise combinations write back into the register
wave_post:
        move    x:<G_MODEL,a
        tst     a
        jne     wp_noacc                ; 8580
        move    x:S_WAVEFORM,x0
        jclr    #1,x0,wp_noacc
        move    #>$d,y0
        move    x0,a
        and     y0,a
        tst     a
        jeq     wp_noacc
        move    x:S_WAVEOUT,a           ; acc &= (waveform_output << 12) | $7fffff
        rep     #12
        asl     a
        move    #>$7fffff,x0
        or      x0,a
        move    x:S_ACC,x0
        and     x0,a
        move    a1,x:S_ACC
wp_noacc:
        move    x:S_WAVEFORM,a
        move    #>8,x0
        cmp     x0,a
        jle     wp_done
        move    x:S_TEST,a
        tst     a
        jne     wp_done
        jsr     write_shift_register
wp_done:
        rts

; reSID WaveformGenerator::set_waveform_output(): used after a control write.
; It also maps noise + pulse through the model's noise_pulse function and
; recomputes pulse_output.
wave_set_output:
        jsr     wave_core
        move    a1,x:S_WAVEOUT
        move    x:S_WAVEFORM,b
        move    #>$c,y0
        and     y0,b
        cmp     y0,b
        jne     wso_post
        move    x:S_WAVEOUT,x0          ; noise_pulse
        move    x:<G_MODEL,a
        tst     a
        jne     wso_8580
        move    x0,a                    ; 6581: noise < $f00 ? 0 : n & (n<<1) & (n<<2)
        move    #>$f00,y0
        cmp     y0,a
        jge     wso_6581_hi
        clr     a
        jmp     wso_np_store
wso_6581_hi:
        lsl     a
        and     x0,a
        move    a1,y0
        move    x0,a
        lsl     a
        lsl     a
        and     x0,a
        and     y0,a
        jmp     wso_np_store
wso_8580:
        move    x0,a                    ; 8580: noise < $fc0 ? n & (n<<1) : $fc0
        move    #>$fc0,y0
        cmp     y0,a
        jge     wso_8580_hi
        lsl     a
        and     x0,a
        jmp     wso_np_store
wso_8580_hi:
        move    #>$fc0,a
wso_np_store:
        move    a1,x:S_WAVEOUT
wso_post:
        jsr     wave_post
        jsr     calc_pulse_out
        rts

; reSID set_waveform_output(delta_t): used every frame
calc_wave_code:
        jsr     wave_core
        move    a1,x:S_WAVEOUT
        jmp     wave_post

; ---- WaveformGenerator::clock(dt), dt = G_DTMIN cycles
wave_clock:
        move    x:S_TEST,a
        tst     a
        jne     wk_test
        move    x:S_FREQ,x0             ; delta = freq * dt
        move    x:<G_DTMIN,y0
        mpy     x0,y0,a
        asr     a
        move    a0,x:S_DELTA
        move    a0,y0                   ; y0 = delta
        move    x:S_ACC,x0
        move    x0,y1                   ; y1 = old phase, for the msb edge
        move    #0,x1
        add     x,a                     ; acc = (acc + delta) & $ffffff
        move    a0,x:S_ACC
        move    a0,x0                   ; x0 = new phase
        clr     b                       ; msb_rising: bit 23 clear before, set after
        jset    #23,y1,wk_msb_done
        jclr    #23,x0,wk_msb_done
        move    #>1,b
wk_msb_done:
        move    b1,x:S_MSB
        ; The noise register steps (reSID's shift loop). A delta below $100000 is a
        ; single partial period: it steps when a bit-19 edge lies in it.
        move    y0,a
        tst     a
        jeq     wk_pulse
        move    #>$100000,x1
        cmp     x1,a
        jge     wk_slow
        move    #>$080000,x1
        cmp     x1,a
        jgt     wk_big
        jset    #19,y1,wk_pulse         ; period <= $80000: step on a rising edge
        jclr    #19,x0,wk_pulse
        jmp     wk_step1
wk_big:
        jclr    #19,y1,wk_step1         ; period > $80000: step unless bit 19 was set and stays clear
        jclr    #19,x0,wk_pulse
wk_step1:
        jsr     clock_shift_register
wk_pulse:
        jmp     calc_pulse_out
wk_slow:
        move    #>$100000,x0
        move    x0,x:S_SHIFTPER
wk_shift_loop:
        move    x:S_DELTA,a
        tst     a
        jeq     wk_shift_done
        move    x:S_SHIFTPER,x0
        cmp     x0,a
        jge     wk_shift_step           ; delta >= period: step
        move    a1,x:S_SHIFTPER         ; period = delta; stop unless a bit-19 edge is crossed
        move    a1,x0
        move    #>$080000,y0
        cmp     y0,a
        jgt     wk_big2
        move    x:S_ACC,a               ; period <= $80000
        sub     x0,a
        jset    #19,a1,wk_shift_done    ; ((acc - period) & $80000) -> stop
        move    x:S_ACC,a
        jclr    #19,a1,wk_shift_done    ; !(acc & $80000) -> stop
        jmp     wk_shift_step
wk_big2:
        move    x:S_ACC,a               ; period > $80000
        sub     x0,a
        jclr    #19,a1,wk_shift_step    ; !((acc - period) & $80000) -> step
        move    x:S_ACC,a
        jset    #19,a1,wk_shift_step    ; (acc & $80000) -> step
        jmp     wk_shift_done
wk_shift_step:
        jsr     clock_shift_register
        move    x:S_DELTA,a
        move    x:S_SHIFTPER,x0
        sub     x0,a
        move    a1,x:S_DELTA
        jmp     wk_shift_loop
wk_shift_done:
        jmp     calc_pulse_out          ; (tail call)
wk_test:
        move    x:S_SRRESET,a           ; test: the register reset countdown runs
        tst     a
        jeq     wk_test_pulse
        move    x:<G_DTMIN,x0
        sub     x0,a
        jgt     wk_srr_keep
        move    #>$7fffff,x0
        move    x0,x:S_SR
        jsr     set_noise_output
        clr     a
wk_srr_keep:
        move    a1,x:S_SRRESET
wk_test_pulse:
        move    #>$fff,x0
        move    x0,x:S_PULSE
        rts

; ---- the cycles until this voice's msb toggles, when the voice it syncs has
; sync enabled: dt_min = min(dt_min, ceil(delta / freq)), delta being the phase
; distance to the next msb change. The division is a search: ceil(delta/freq) <
; dt_min exactly when delta <= freq * (dt_min - 1).
sync_check:
        move    x:DST_SYNC,a
        tst     a
        jeq     sc_done
        move    x:S_FREQ,a
        tst     a
        jeq     sc_done
        clr     a                       ; delta = $800000 - (acc & $7fffff)
        move    x:S_ACC,a1
        move    #>$7fffff,x0
        and     x0,a
        clr     b
        move    #>$800000,b1
        sub     a,b                     ; b = delta
        move    x:<G_DTMIN,a
        move    #>1,x0
        sub     x0,a
        move    a1,y0
        move    x:S_FREQ,x0
        mpy     x0,y0,a                 ; freq * (dt_min - 1)
        asr     a
        move    a0,x0
        clr     a
        move    x0,a1
        cmp     b,a                     ; limit - delta
        jlt     sc_done                 ; no toggle within dt_min - 1 cycles
        clr     a                       ; smallest k with freq * k >= delta
        move    #0,r2
        move    x:S_FREQ,y0
sc_loop:
        move    (r2)+
        add     y0,a
        cmp     b,a
        jlt     sc_loop
        move    r2,x0
        move    x0,x:<G_DTMIN
sc_done:
        rts

; ---- hard sync: if this voice's msb rose and the voice it syncs has sync set
; (and this voice is not itself synced by a source whose msb also rose), the
; synced voice restarts its phase
synchronize:
        move    x:S_MSB,a
        tst     a
        jeq     sy_done
        move    x:DST_SYNC,a
        tst     a
        jeq     sy_done
        move    x:S_SYNC,a
        tst     a
        jeq     sy_do
        move    x:SRC_MSB,a
        tst     a
        jne     sy_done
sy_do:
        clr     a
        move    a1,x:DST_ACC
sy_done:
        rts

; ---- waveform output at the frame's end, then
; (wave DAC - zero) * envelope DAC into S_OUT. The routine that makes the
; waveform code is chosen when the control register is written (S_WH): plain
; triangle, saw, pulse and noise have their own short ones, everything else (no
; waveform, combined waveforms, ring modulated triangle) the general path.
outstage:
        move    x:S_WH,r1
        nop
        jmp     (r1)
os_generic:
        jsr     calc_wave_code
        jmp     os_output
os_saw:                                 ; code = phase >> 12
        move    x:S_ACC,x0
        move    #>$800,y0
        mpy     x0,y0,a                 ; (phase as a signed fraction * 2^11: a1 = phase >> 12, sign-extended)
        move    #>$fff,x0
        and     x0,a
        jmp     os_have_code
os_tri:                                 ; ((ix ^ (msb ? $7ff : 0)) & $7ff) << 1
        move    x:S_ACC,x0
        move    #>$800,y0
        mpy     x0,y0,a
        move    #>$fff,x0
        and     x0,a
        move    a1,x0
        move    #>$7ff,y0
        jclr    #11,x0,ost_nofold
        eor     y0,a
ost_nofold:
        and     y0,a
        lsl     a
        jmp     os_have_code
os_pulse:
        move    x:S_PULSE,a
        jmp     os_have_code
os_noise:
        move    y:S_NOISE,a
os_have_code:
        move    a1,x:S_WAVEOUT
        move    a1,n1
        jmp     os_dac
os_floating:
        move    x:S_TTL,a
        tst     a
        jeq     os_output
        move    x:<G_N,x0
        sub     x0,a
        jgt     os_ttl_keep
        clr     a
        move    a1,x:S_WAVEOUT
os_ttl_keep:
        move    a1,x:S_TTL
os_output:
        move    x:S_WAVEOUT,n1
os_dac:
        move    #>DSP_X_WAVE_DAC,r1
        nop
        move    x:(r1+n1),a
        move    x:<G_ZERO,x0
        sub     x0,a
        move    a1,x0
        move    x:S_ENVCNT,n1
        move    #>DSP_X_ENV_DAC,r1
        nop
        move    x:(r1+n1),y0
        mpy     x0,y0,a
        asr     a
        move    a0,x:S_OUT
        rts

; ---- EnvelopeGenerator::clock(dt), dt = S_TMPDT
env_clock:
        move    x:S_PIPE,a
        tst     a
        jeq     ec_nopipe
        move    x:S_NEXT,a
        tst     a
        jne     ec_p_rel
        clr     a                       ; next state ATTACK
        move    a1,x:S_STATE
        move    a1,x:S_HOLD
        move    x:S_ATTACK,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
        jmp     ec_p_done
ec_p_rel:
        move    #>ST_RELEASE,x0
        cmp     x0,a
        jne     ec_p_done
        move    x0,x:S_STATE
        move    x:S_RELEASE,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
ec_p_done:
        clr     a
        move    a1,x:S_PIPE
ec_nopipe:
        move    x:S_RATEPER,a           ; rate_step = period - counter
        move    x:S_RATECNT,b
        sub     b,a
        jle     ec_bug                  ; <= 0: the ADSR delay bug
        move    x:<G_N,x1               ; dt
        cmp     x1,a
        jgt     ec_tick                 ; dt < rate_step: no step this frame
        jmp     ec_quiet_check
ec_tick:                                ; the common frame: just advance the counter
        add     x1,b                    ; (counter + dt < period, no wrap)
        move    b1,x:S_RATECNT
        rts
ec_bug:
        move    #>$7fff,x0
        add     x0,a
        move    a1,x:S_TMPSTEP
        move    x:<G_N,a
        move    a1,x:S_TMPDT
        jmp     ec_loop

; At least one rate step falls in this frame. If the envelope is idle - at its
; sustain level, or held at zero - the steps change nothing but the exponential
; counter, so all of them are applied at once: k steps leave the rate counter at
; (dt - step) mod period and the exponential counter at (count + k) mod period.
; a = rate_step, x1 = dt on entry.
ec_quiet_check:
        move    x:S_HOLD,b
        tst     b
        jne     ecq_hold
        move    x:S_STATE,b
        move    #>ST_DECSUS,x0
        cmp     x0,b
        jne     ec_general
        move    x:S_SUSTAIN,n1
        move    #>DSP_X_SUST_TAB,r1
        nop
        move    x:(r1+n1),x0
        move    x:S_ENVCNT,b
        cmp     x0,b
        jne     ec_general              ; still decaying
        jmp     ecq_do
ecq_hold:
        move    x:S_STATE,b
        tst     b
        jeq     ec_general              ; attack
ecq_do:
        move    x:S_EXPCNT,b            ; the closed form needs count < period
        move    x:S_EXPPER,y0
        cmp     y0,b
        jge     ec_general
        move    x1,b                    ; b = dt - rate_step, k = 1
        sub     a,b
        move    #1,r2
        move    x:S_RATEPER,x0
ecq_loop:
        cmp     x0,b
        jlt     ecq_done
        sub     x0,b
        move    (r2)+
        jmp     ecq_loop
ecq_done:
        move    b1,x:S_RATECNT
        move    y0,a
        move    #>1,x0
        cmp     x0,a
        jne     ecq_expgo
        clr     a                       ; period 1: the count stays 0
        jmp     ecq_exp_done
ecq_expgo:
        move    x:S_EXPCNT,a            ; (count + k) mod exponential period
        move    r2,x0
        add     x0,a
ecq_exp:
        cmp     y0,a
        jlt     ecq_exp_done
        sub     y0,a
        jmp     ecq_exp
ecq_exp_done:
        move    a1,x:S_EXPCNT
        rts

; the general step loop: a = rate_step
ec_general:
        move    a1,x:S_TMPSTEP
        move    x1,x:S_TMPDT
ec_loop:
        move    x:S_TMPDT,a
        tst     a
        jeq     ec_done
        move    x:S_TMPSTEP,x0
        cmp     x0,a
        jge     ec_step
        move    x:S_RATECNT,b           ; dt < rate_step: advance the counter and stop
        add     a,b
        jclr    #15,b1,ec_store
        move    #>1,x0
        add     x0,b
        move    #>$7fff,x0
        and     x0,b
ec_store:
        move    b1,x:S_RATECNT
ec_done:
        rts
ec_step:
        clr     b                       ; rate_counter = 0, dt -= rate_step
        move    b1,x:S_RATECNT
        sub     x0,a
        move    a1,x:S_TMPDT
        move    x:S_STATE,a
        tst     a
        jeq     ec_do_step              ; attack steps every period
        move    x:S_EXPCNT,a
        move    #>1,x0
        add     x0,a
        move    a1,x:S_EXPCNT
        move    x:S_EXPPER,x0
        cmp     x0,a
        jne     ec_next
ec_do_step:
        clr     a
        move    a1,x:S_EXPCNT
        move    x:S_HOLD,a
        tst     a
        jne     ec_next                 ; frozen at zero
        move    x:S_STATE,a
        tst     a
        jeq     ec_attack
        move    #>ST_DECSUS,x0
        cmp     x0,a
        jeq     ec_decsus
ec_dec:                                 ; release: env = (env - 1) & $ff
        move    x:S_ENVCNT,a
        move    #>1,x0
        sub     x0,a
        move    #>$ff,x0
        and     x0,a
        move    a1,x:S_ENVCNT
        jmp     ec_setexp
ec_decsus:                              ; decrement unless at the sustain level
        move    x:S_SUSTAIN,a
        move    a1,n1
        move    #>DSP_X_SUST_TAB,r1
        nop
        move    x:(r1+n1),x0
        move    x:S_ENVCNT,a
        cmp     x0,a
        jeq     ec_next                 ; at the sustain level: nothing changes
        jmp     ec_dec
ec_attack:
        move    x:S_ENVCNT,a
        move    #>1,x0
        add     x0,a
        move    #>$ff,x0
        and     x0,a
        move    a1,x:S_ENVCNT
        cmp     x0,a
        jne     ec_setexp
        move    #>ST_DECSUS,x0          ; reached $ff: decay
        move    x0,x:S_STATE
        move    x:S_DECAY,a
        jsr     rate_lookup
        move    a1,x:S_RATEPER
ec_setexp:                              ; exponential counter period by envelope value
        move    x:S_ENVCNT,a
        move    #>$ff,x0
        cmp     x0,a
        jeq     ec_e_1
        move    #>$5d,x0
        cmp     x0,a
        jeq     ec_e_2
        move    #>$36,x0
        cmp     x0,a
        jeq     ec_e_4
        move    #>$1a,x0
        cmp     x0,a
        jeq     ec_e_8
        move    #>$0e,x0
        cmp     x0,a
        jeq     ec_e_16
        move    #>$06,x0
        cmp     x0,a
        jeq     ec_e_30
        tst     a
        jne     ec_next
        move    #>1,x0                  ; zero: hold
        move    x0,x:S_HOLD
        jmp     ec_e_store
ec_e_1:
        move    #>1,x0
        jmp     ec_e_store
ec_e_2:
        move    #>2,x0
        jmp     ec_e_store
ec_e_4:
        move    #>4,x0
        jmp     ec_e_store
ec_e_8:
        move    #>8,x0
        jmp     ec_e_store
ec_e_16:
        move    #>16,x0
        jmp     ec_e_store
ec_e_30:
        move    #>30,x0
ec_e_store:
        move    x0,x:S_EXPPER
ec_next:
        move    x:S_RATEPER,a
        move    a1,x:S_TMPSTEP
        jmp     ec_loop
;@endvoice

        end
